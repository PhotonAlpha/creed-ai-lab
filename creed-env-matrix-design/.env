VITE_API_TARGET=https://localhost:18095
# The Splunk broker is creed-gateway-proxy (mvn -pl creed-gateway-proxy spring-boot:run). The Node
# BFF (npm run bff, :3002) still speaks the same contract, without the block window.
VITE_SPLUNK_TARGET=http://localhost:8088
# Veracode analysis (mvn -pl creed-resource/creed-resource-veracode spring-boot:run): plain HTTP, mocks
# Confluence and Jira in-process by default.
VITE_VERACODE_TARGET=http://localhost:18097
# Migration sync risk (mvn -pl creed-resource/creed-resource-migration-risk spring-boot:run): plain HTTP,
# ships two demo repositories so the page works without real checkouts.
VITE_MIGRATION_RISK_TARGET=http://localhost:18098
