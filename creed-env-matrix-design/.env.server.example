# Env Matrix BFF (server/bff.js) — copy to .env.server.local (git-ignored via *.local); `npm run bff`
# loads it. Real environment variables win over this file. Every secret below also accepts NAME_FILE
# (a path whose contents are the value) — use that for Docker/Kubernetes secrets or a Vault agent sink.

# --- BFF -------------------------------------------------------------------------------------------
# BFF_PORT=3002
# BFF_HOST=
# BFF_STATIC_DIR=./dist
# ENV_MATRIX_API_TARGET=https://localhost:18095
# (false + ENV_MATRIX_API_CA_FILE to verify the backend)
# ENV_MATRIX_API_INSECURE=true
# ENV_MATRIX_API_CA_FILE=

# --- TOTP gate -------------------------------------------------------------------------------------
# Base32. The built-in fallback JBSWY3DPEHPK3PXP is a DEMO secret.
# ENV_MATRIX_TOTP_SECRET=
# ENV_MATRIX_TOTP_SECRET_FILE=
# (false: the code must come from an authenticator app)
# ENV_MATRIX_TOTP_EXPOSE_CODE=true
# ENV_MATRIX_TOTP_PERIOD_SECONDS=30
# ENV_MATRIX_TOTP_DIGITS=6
# ENV_MATRIX_TOTP_DRIFT_STEPS=1
# ENV_MATRIX_TOTP_REJECT_REPLAY=true
# ENV_MATRIX_TOTP_MAX_FAILURES=5
# ENV_MATRIX_TOTP_FAILURE_WINDOW_SECONDS=60

# --- Splunk ----------------------------------------------------------------------------------------
# (true: real login; false: fabricated mock-… cookie)
# SPLUNK_ENABLED=false
# (one login target, "default" — used when SPLUNK_TARGETS is not set)
# SPLUNK_LOGIN_URL=https://<host>:8000/en-US/account/login
# SPLUNK_USERNAME=
# SPLUNK_PASSWORD=
# SPLUNK_PASSWORD_FILE=
# (several login targets, offered in the page's dropdown; ids are letters/digits/_ — each target has its
#  OWN url/username/password, there is no fallback to the SPLUNK_LOGIN_URL/USERNAME/PASSWORD above)
# SPLUNK_TARGETS=SIT,UAT
# SPLUNK_DEFAULT_TARGET=SIT
# SPLUNK_TARGET_SIT_LABEL=SIT (CN)
# SPLUNK_TARGET_SIT_LOGIN_URL=https://<sit-host>:8000/en-US/account/login
# SPLUNK_TARGET_SIT_USERNAME=
# SPLUNK_TARGET_SIT_PASSWORD=
# SPLUNK_TARGET_SIT_PASSWORD_FILE=
# (optional; defaults to SPLUNK_SESSION_COOKIE — splunkd_<port> follows Splunk Web's port)
# SPLUNK_TARGET_SIT_SESSION_COOKIE=splunkd_8000
# SPLUNK_TARGET_UAT_LOGIN_URL=https://<uat-host>:8000/en-US/account/login
# SPLUNK_TARGET_UAT_USERNAME=
# SPLUNK_TARGET_UAT_PASSWORD=
# (skip Splunk certificate verification (chain + hostname))
# SPLUNK_TLS_INSECURE=true
# (PEM, used only with SPLUNK_TLS_INSECURE=false)
# SPLUNK_CA_FILE=
# SPLUNK_SESSION_COOKIE=splunkd_8000
# SPLUNK_SCRIPT_COOKIE_NAME=splunkd_8089
# SPLUNK_SCRIPT_COOKIE_PATH=/
# SPLUNK_PREFETCH_CVAL=true
# SPLUNK_CONNECT_TIMEOUT_MS=5000
# SPLUNK_READ_TIMEOUT_MS=15000

# --- Audit -----------------------------------------------------------------------------------------
# (memory = default, newest 500 rows, lost on restart · pg = splunk_broker.splunk_audit in PostgreSQL · mysql = splunk_audit in the URL's MySQL database; the SPLUNK_DB_* lines apply to pg and mysql)
# SPLUNK_AUDIT_STORE=memory
# (default postgres://127.0.0.1:5432/env_matrix, or mysql://127.0.0.1:3306/env_matrix with SPLUNK_AUDIT_STORE=mysql)
# SPLUNK_DB_URL=postgres://127.0.0.1:5432/env_matrix
# SPLUNK_DB_USER=artifactory
# SPLUNK_DB_PASSWORD=
# SPLUNK_DB_PASSWORD_FILE=
# (pg only)
# SPLUNK_AUDIT_SCHEMA=splunk_broker
