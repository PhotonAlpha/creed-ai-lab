<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.creed</groupId>
        <artifactId>spring-creed-auth-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>creed-common-metrics</artifactId>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ============ OpenTelemetry ============ -->
        <!-- Bridges Micrometer Observation/Tracing to OpenTelemetry -->
        <!-- Spring Boot 4 moved tracing auto-configuration out of spring-boot-starter-actuator into
             its own module. Without it the Micrometer bridge below registers no Tracer bean and any
             component injecting io.micrometer.tracing.Tracer fails the context at startup. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- Pulls in the OTel SDK auto-config + OTLP exporters for traces/metrics/logs
             and provides the SdkLoggerProvider the Logback appender needs. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-spring-boot-starter</artifactId>
        </dependency>
        <!-- Logback appender that ships log records over OTLP to the collector -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
        </dependency>

        <!-- ConnectionPoolMetrics observes an Apache hc5 pool. Optional: only the modules that
             actually run an hc5 pool need it, and every one of those already declares it. -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>
</project>