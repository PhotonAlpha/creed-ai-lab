<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.creed</groupId>
    <artifactId>spring-creed-auth-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-creed-auth-server</name>
    <description>Creed multi-module OAuth2 stack (Authorization Server + Gateway + Resources)</description>

    <properties>
        <java.version>21</java.version>
        <spring-boot.version>4.0.6</spring-boot.version>
        <spring-cloud.version>2025.1.1</spring-cloud.version>
        <!-- OpenTelemetry Java Instrumentation BOM: aligns opentelemetry-spring-boot-starter,
             OTLP exporters and the Logback appender on a single version. -->
        <otel-instrumentation.version>2.20.1</otel-instrumentation.version>
        <!-- Matching OpenTelemetry SDK/API version. Must override Spring Boot's pin
             (otherwise the incubator artifact pulled in by instrumentation 2.20.1 sees
             an older API and fails with NoClassDefFoundError: ComponentLoader). -->
        <opentelemetry.version>1.54.1</opentelemetry.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
    </properties>

    <modules>
        <module>creed-author-server</module>
        <module>creed-gateway</module>
        <module>creed-resource</module>
        <module>creed-report</module>
        <module>creed-config-server</module>
        <module>creed-none-author</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Imported BEFORE spring-boot-dependencies so its newer opentelemetry-api/sdk
                 versions win over Boot's older pins. Required by instrumentation 2.20.1. -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom</artifactId>
                <version>${otel-instrumentation.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Alpha BOM manages opentelemetry-spring-boot-starter and the Logback OTLP
                 appender (opentelemetry-logback-appender-1.0); both stay in alpha until GA. -->
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom-alpha</artifactId>
                <version>${otel-instrumentation.version}-alpha</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!-- Retain method parameter names in bytecode (-parameters). Spring MVC needs
                             them to bind @RequestParam/@PathVariable when no explicit name is given,
                             e.g. MockRestController.callGateway(@RequestParam ... path). -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
