<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.creed</groupId>
    <artifactId>spring-creed-auth-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-creed-auth-server</name>
    <description>Creed multi-module OAuth2 stack (Authorization Server + Gateway + Resources)</description>

    <properties>
        <java.version>21</java.version>
        <spring-boot.version>3.5.14</spring-boot.version>
        <spring-cloud.version>2025.0.2</spring-cloud.version>
        <!-- OpenTelemetry Java Instrumentation BOM: aligns opentelemetry-spring-boot-starter,
             OTLP exporters and the Logback appender on a single version. -->
        <otel-instrumentation.version>2.20.1</otel-instrumentation.version>
        <!-- Matching OpenTelemetry SDK/API version. Must override Spring Boot's pin
             (otherwise the incubator artifact pulled in by instrumentation 2.20.1 sees
             an older API and fails with NoClassDefFoundError: ComponentLoader). -->
        <opentelemetry.version>1.54.1</opentelemetry.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <modules>
        <module>creed-author-server</module>
        <module>creed-gateway</module>
        <module>creed-resource</module>
        <module>creed-report</module>
        <module>creed-config-server</module>
        <module>creed-gateway-partner</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Imported BEFORE spring-boot-dependencies so its newer opentelemetry-api/sdk
                 versions win over Boot's older pins. Required by instrumentation 2.20.1. -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom</artifactId>
                <version>${otel-instrumentation.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Alpha BOM manages opentelemetry-spring-boot-starter and the Logback OTLP
                 appender (opentelemetry-logback-appender-1.0); both stay in alpha until GA. -->
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom-alpha</artifactId>
                <version>${otel-instrumentation.version}-alpha</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- ============ OpenTelemetry ============ -->
        <!-- Bridges Micrometer Observation/Tracing to OpenTelemetry -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- Pulls in the OTel SDK auto-config + OTLP exporters for traces/metrics/logs
             and provides the SdkLoggerProvider the Logback appender needs. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-spring-boot-starter</artifactId>
        </dependency>
        <!-- Logback appender that ships log records over OTLP to the collector -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!-- Retain method parameter names in bytecode (-parameters). Spring MVC needs
                             them to bind @RequestParam/@PathVariable when no explicit name is given,
                             e.g. MockRestController.callGateway(@RequestParam ... path). -->
                        <parameters>true</parameters>
                        <!-- Since JDK 23 javac no longer runs annotation processors found only on the
                             classpath; Lombok must be declared explicitly here or @Slf4j/@Data etc. are
                             silently skipped. Version is managed by the Spring Boot BOM. -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
