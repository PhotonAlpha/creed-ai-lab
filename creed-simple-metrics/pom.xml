<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.creed</groupId>
        <artifactId>spring-creed-auth-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>creed-simple-metrics</artifactId>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <logbook.version>3.9.0</logbook.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Provides the configserver: resolver for the optional spring.config.import below
             (kept for parity with the other modules; the config server is optional here). -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!-- ===== HTTP request/response audit (Zalando Logbook) =====
             Replaces the hand-written audit block logging:
             - the starter auto-registers a servlet LogbookFilter (inbound /camel/* audit,
               formerly AuditLoggingFilter — kept behind creed.audit.legacy-filter.enabled);
             - logbook-httpclient5 provides the hc5 exec-chain integration (downstream audit,
               formerly the body/header part of CamelLoadBalancerAuditExecHandler).
             Formatting/obfuscation/body-size live under the `logbook.*` keys in application.yml;
             output goes to the `org.zalando.logbook` TRACE logger (enabled in logback-spring.xml). -->
        <dependency>
            <groupId>org.zalando</groupId>
            <artifactId>logbook-spring-boot-starter</artifactId>
            <version>${logbook.version}</version>
        </dependency>
        <dependency>
            <groupId>org.zalando</groupId>
            <artifactId>logbook-httpclient5</artifactId>
            <version>${logbook.version}</version>
        </dependency>

        <!-- ===== Apache Camel (Spring Boot) ===== -->
        <!-- Core Camel-on-Spring-Boot auto-configuration + CamelContext. -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-spring-boot-starter</artifactId>
        </dependency>
        <!-- REST DSL + the servlet transport that mounts the routes on the embedded Tomcat
             (CamelHttpTransportServlet under camel.servlet.mapping.context-path). -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-rest-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-servlet-starter</artifactId>
        </dependency>
        <!-- Classic Spring XML DSL: enables the <camelContext xmlns=".../schema/spring"> element
             (with inline <threadPool>, <restConfiguration>, <rest> and <route>) loaded via
             @ImportResource (see SimpleMetricsApplication / camel-context.xml). -->
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-spring-xml</artifactId>
        </dependency>
        <!-- JSON binding for the REST DSL and the downstream-response unmarshalling. -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-jackson-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-http-starter</artifactId>
        </dependency>
        <!-- Spring Cloud LoadBalancer: the downstream call now happens in a Camel Processor that uses
             a @LoadBalanced RestClient, so the instance is chosen by Spring Cloud LB (over the
             SimpleDiscoveryClient registry in application.yml) instead of Camel's loadBalance EIP. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Bridges Camel routes to Micrometer Observation, so each route/processor and the
             downstream call create spans and propagate the trace context (trace/span IDs then flow
             through the routes and appear in the correlated logs). -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-observation-starter</artifactId>
        </dependency>

        <!-- ===== Distributed tracing (Micrometer Tracing + Brave) ===== -->
        <!-- Brave bridge: turns Micrometer Observations into Brave spans and populates the
             traceId/spanId MDC that Spring Boot's default log pattern (LOG_CORRELATION_PATTERN) shows.
             Version managed by the Spring Boot (micrometer-tracing) BOM. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <!-- ContextExecutorService/ContextSnapshot: carries the Observation scope (and with it the
             Brave span + local baggage -> MDC) onto the ProducerTemplate async executor threads.
             Already transitive via micrometer-tracing; declared because CamelConfig compiles against it. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>

        <!-- Apache HttpClient 5: backs the @LoadBalanced RestClient's mTLS request factory
             (version managed by the Spring Boot BOM). -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Brings Nimbus JOSE (JWKSource built from the mTLS keystore, see
             SslBundleConfiguration#jwkSource) plus the NimbusJwtEncoder/JwtDecoder that consume it.
             Boot's BOM manages this starter but no longer pins nimbus-jose-jwt directly, so depending
             on the raw Nimbus artifact would need an explicit version — this keeps versions aligned. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!-- Test only: JUnit 5 + Spring's MockHttpServletRequest/Response/MockFilterChain, used to
             drive CookieSanitizingFilter end-to-end without an embedded container. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>