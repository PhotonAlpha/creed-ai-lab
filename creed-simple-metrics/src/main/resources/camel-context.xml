<?xml version="1.0" encoding="UTF-8"?>
<!--
  Classic Spring XML DSL: a single <camelContext> that loads ALL the REST routes (plus the supporting
  direct: routes and the two thread pools). Loaded via @ImportResource on SimpleMetricsApplication.

  Differences from the modern XML IO DSL this replaced:
    - wrapped in a Spring <beans> document and uses the camel "spring" namespace;
    - thread pools are declared inline with <threadPool> (referenced by id).
  NOTE: Camel 4 unified the route model, so the EIP attributes here are the SAME as the IO DSL
  (aggregationStrategy / executorService), NOT the Camel 3 *Ref names (strategyRef / executorServiceRef).

  REST is served through the camel-servlet transport (restConfiguration component="servlet"); the
  servlet mount point stays in application.yml (camel.servlet.mapping.context-path=/camel/*), so the
  APIs live under https://host:8096/camel/api/*.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://camel.apache.org/schema/spring
                           http://camel.apache.org/schema/spring/camel-spring.xsd">

    <camelContext xmlns="http://camel.apache.org/schema/spring">

        <!-- ===== thread pools =====
             Defined as Micrometer-monitored Spring ExecutorService beans in
             CamelThreadPoolConfiguration (aggregatePoolA / notificationPoolB) instead of inline
             <threadPool> elements, so they emit executor_* metrics. The executorService="<id>" refs
             below resolve to those beans from the registry. -->

        <!-- ===== REST transport + JSON binding ===== -->
        <restConfiguration component="servlet" bindingMode="json" inlineRoutes="false"/>

        <!-- ===== REST API surface ===== -->
        <rest path="/api">
            <get path="/hello" produces="application/json">
                <to uri="direct:hello"/>
            </get>
            <get path="/time" produces="application/json">
                <to uri="direct:time"/>
            </get>
            <post path="/echo" consumes="application/json" produces="application/json">
                <to uri="direct:echo"/>
            </post>
            <get path="/catalog" produces="application/json">
                <to uri="direct:catalog"/>
            </get>
            <get path="/order" produces="application/json">
                <to uri="direct:order"/>
            </get>
            <get path="/aggregate" produces="application/json">
                <to uri="direct:aggregate"/>
            </get>
            <get path="/aggregate-notify" produces="application/json">
                <to uri="direct:aggregateNotify"/>
            </get>
            <!-- Complex pipeline: aggregate (multicast) -> filter -> enrich (multicast) -> notify/fail.
                 Optional JSON body {"failCatalog":true,"failOrder":true} fault-injects a downstream 5xx. -->
            <post path="/fulfillment" consumes="application/json" produces="application/json">
                <to uri="direct:fulfillment"/>
            </post>
            <!-- Cookie corruption repro: session + double echo against ?cluster=order|catalog.
                 Watch org.apache.hc.client5.http.wire for the $Path="/"; $Domain=... Cookie header. -->
            <post path="/cookie-relay" produces="application/json">
                <to uri="direct:cookieRelay"/>
            </post>
        </rest>

        <!-- ===== self-contained routes ===== -->
        <route id="hello">
            <from uri="direct:hello"/>
            <to uri="bean:apiHandlers?method=hello"/>
        </route>

        <route id="time">
            <from uri="direct:time"/>
            <to uri="bean:apiHandlers?method=time"/>
        </route>

        <route id="echo">
            <from uri="direct:echo"/>
            <log message="echo received: ${body}"/>
        </route>

        <!-- ===== downstream-backed routes ===== -->
        <route id="catalog">
            <from uri="direct:catalog"/>
            <log message="catalog branch on thread=${threadName}"/>
            <to uri="direct:fetch-catalog"/>
            <setHeader name="source">
                <constant>catalog</constant>
            </setHeader>
        </route>

        <route id="order">
            <from uri="direct:order"/>
            <log message="order branch on thread=${threadName}"/>
            <to uri="direct:fetch-order"/>
            <setHeader name="source">
                <constant>order</constant>
            </setHeader>
        </route>

        <route id="aggregate">
            <from uri="direct:aggregate"/>
            <multicast aggregationStrategy="aggregateStrategy" parallelProcessing="true">
                <to uri="direct:catalog"/>
                <to uri="direct:order"/>
            </multicast>
        </route>

        <!-- Aggregation + notification:
             1) wireTap fires a fire-and-forget notification on thread pool B;
             2) the multicast aggregates catalog + order on thread pool A. -->
        <route id="aggregateNotify">
            <from uri="direct:aggregateNotify"/>
            <wireTap uri="direct:notification" executorService="notificationPoolB"/>
            <multicast aggregationStrategy="aggregateStrategy" parallelProcessing="true"
                       executorService="aggregatePoolA">
                <to uri="direct:catalog"/>
                <to uri="direct:order"/>
            </multicast>
        </route>

        <route id="notification">
            <from uri="direct:notification"/>
            <log message="notification sent for aggregate request on thread=${threadName}"/>
        </route>

        <!-- ===== downstream cluster calls (Spring Cloud LoadBalancer, invoked in a Processor) =====
             The instance is chosen by Spring Cloud LB resolving the https://<service-id> URL; the call
             and JSON binding happen inside RemoteClusterProcessor (mTLS @LoadBalanced RestClient). -->
        <route id="fetch-catalog">
            <from uri="direct:fetch-catalog"/>
            <setHeader name="clusterUrl">
                <constant>https://catalog-resource/api/catalog/items</constant>
            </setHeader>
            <process ref="remoteClusterProcessor"/>
        </route>

        <!-- Reproduces the "$Path"/"$Domain" Cookie-header corruption end-to-end: the processor logs in
             against the chosen cluster, re-serializes the Set-Cookie headers via HttpCookie.toString()
             (the bug) and via plain name=value (the fix), and forwards both to the cluster's /echo. -->
        <route id="cookieRelay">
            <from uri="direct:cookieRelay"/>
            <log message="cookie-relay cluster=${header.cluster} on thread=${threadName}"/>
            <process ref="cookieRelayProcessor"/>
        </route>

        <route id="fetch-order">
            <from uri="direct:fetch-order"/>
            <setHeader name="clusterUrl">
                <constant>https://order-resource/api/order/items</constant>
            </setHeader>
            <process ref="remoteClusterProcessor"/>
        </route>

        <!-- ============================================================================
             Complex fulfillment pipeline (GET /api/fulfillment):
               1. multicast  -> fetch catalog + order BULK lists in parallel, aggregate
               5. if a branch failed (error status) -> return a failure response body
               2. filter     -> keep only fulfillable orders (status + catalog stock)
               3. multicast  -> internal routers enrich with shipping + risk
               4. success    -> wireTap a fire-and-forget notification
             ============================================================================ -->
        <route id="fulfillment">
            <from uri="direct:fulfillment"/>
            <!-- (0) lift the optional fault-injection flags from the JSON body into headers -->
            <process ref="fulfillmentRequestProcessor"/>
            <!-- (1) parallel aggregate of the two downstream clusters -->
            <multicast aggregationStrategy="fulfillmentAggregateStrategy" parallelProcessing="true"
                       executorService="aggregatePoolA">
                <to uri="direct:fetch-catalog-bulk"/>
                <to uri="direct:fetch-order-bulk"/>
            </multicast>
            <choice>
                <!-- (5) any downstream error status -> failure response body -->
                <when>
                    <simple>${header.downstreamError} == true</simple>
                    <log loggingLevel="WARN"
                         message="fulfillment downstream failure status=${header.downstreamStatus}"/>
                    <process ref="failureResponseProcessor"/>
                </when>
                <otherwise>
                    <!-- (2) filter the aggregated orders down to the fulfillable ones -->
                    <process ref="fulfillmentFilterProcessor"/>
                    <!-- (3) enrich via a second multicast over internal routers -->
                    <setProperty name="fulfillmentBase">
                        <simple>${body}</simple>
                    </setProperty>
                    <multicast aggregationStrategy="enrichmentAggregateStrategy" parallelProcessing="true"
                               executorService="aggregatePoolA">
                        <to uri="direct:enrich-shipping"/>
                        <to uri="direct:enrich-risk"/>
                    </multicast>
                    <!-- (4) success -> notify (fire-and-forget on pool B) -->
                    <wireTap uri="direct:fulfillment-notification" executorService="notificationPoolB"/>
                </otherwise>
            </choice>
        </route>

        <!-- Downstream BULK fetches, resilient=true so RemoteClusterProcessor captures error status
             into branchError/branchStatus instead of throwing. failCatalog/failOrder request headers
             (from the REST query) fault-inject a 5xx on the matching cluster. -->
        <route id="fetch-catalog-bulk">
            <from uri="direct:fetch-catalog-bulk"/>
            <setHeader name="source"><constant>catalog</constant></setHeader>
            <setHeader name="resilient"><constant>true</constant></setHeader>
            <setHeader name="clusterUrl">
                <simple>https://catalog-resource/api/catalog/bulk?fail=${header.failCatalog}</simple>
            </setHeader>
            <process ref="remoteClusterProcessor"/>
        </route>

        <route id="fetch-order-bulk">
            <from uri="direct:fetch-order-bulk"/>
            <setHeader name="source"><constant>order</constant></setHeader>
            <setHeader name="resilient"><constant>true</constant></setHeader>
            <setHeader name="clusterUrl">
                <simple>https://order-resource/api/order/bulk?fail=${header.failOrder}</simple>
            </setHeader>
            <process ref="remoteClusterProcessor"/>
        </route>

        <!-- Internal enrichment routers (no downstream HTTP): each tags itself with a source header
             and delegates the per-order computation to the fulfillmentEnricher bean. -->
        <route id="enrich-shipping">
            <from uri="direct:enrich-shipping"/>
            <setHeader name="source"><constant>shipping</constant></setHeader>
            <to uri="bean:fulfillmentEnricher?method=shipping"/>
        </route>

        <route id="enrich-risk">
            <from uri="direct:enrich-risk"/>
            <setHeader name="source"><constant>risk</constant></setHeader>
            <to uri="bean:fulfillmentEnricher?method=risk"/>
        </route>

        <route id="fulfillment-notification">
            <from uri="direct:fulfillment-notification"/>
            <log message="fulfillment notification: ${body[summary]} on thread=${threadName}"/>
        </route>

    </camelContext>
</beans>
