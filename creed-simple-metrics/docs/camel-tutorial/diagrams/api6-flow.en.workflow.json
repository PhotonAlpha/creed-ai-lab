  "cards": [
    {
      "dot": "cyan",
      "title": "Two branch points",
      "items": [
        "Order Grading is a 3-way <choice>: the branches set different orderLevel values and then rejoin",
        "Fulfilment Guard is a 1-way <filter>: APPROVED runs the split, REJECTED goes straight to the reply"
      ]
    },
    {
      "dot": "rose",
      "title": "Two semantics people get wrong",
      "items": [
        "<filter> only skips its own body when unmatched; the route keeps running and still replies 200",
        "<wireTap> returns the moment the copy is sent; the main flow neither waits nor sees its errors"
      ]
    }
  ]
}