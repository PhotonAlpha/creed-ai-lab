    },
    {
      "id": "e-fanout",
      "from": "scatter",
      "to": "scoring",
      "label": "copy to 3 branches",
      "variant": "emphasis",
      "role": "branch"
    },
    {
      "id": "e-agg",
      "from": "scoring",
