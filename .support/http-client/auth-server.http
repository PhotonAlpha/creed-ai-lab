POST http://127.0.0.1:9000/auth-server/oauth2/token
Authorization: Basic Y3JlZWQtY2xpZW50OmNyZWVkLXNlY3JldA==
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&scope=api.read

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is  200");
    });
    console.log('ResponseData', response.body)
    const {access_token} = response.body
    client.global.set("auth_token", access_token);
    client.log("Token updated: " + client.global.get("auth_token"));
%}

### gateway catalog items
http://127.0.0.1:8080/api/catalog/items
Accept: application/json
Authorization: Bearer {{auth_token}}


### gateway order items
http://127.0.0.1:8080/api/order/items
Accept: application/json
Authorization: Bearer {{auth_token}}


