<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.creed</groupId>
        <artifactId>creed-resource</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>creed-resource-lb-health</artifactId>
    <name>creed-resource-lb-health</name>
    <description>
        Spring Cloud LoadBalancer health-check lab: get() must only ever return a complete round's list.
        The app is both the client and its own 10 target instances (extra Tomcat connectors).
    </description>

    <properties>
        <!-- not in any BOM; 4.x is the Boot 4 / Jackson 3 line (as creed-simple-metrics, creed-resource-veracode) -->
        <logbook.version>4.2.0</logbook.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Only for the optional `webclient` health-check mode (withHealthChecks(WebClient), concurrent
             non-blocking probes). The servlet stack still wins the web-application-type detection, and
             without spring-boot-webclient there is no WebClient.Builder bean, so nothing reactive is
             auto-configured. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>

        <!-- Health-check request/response log (Splunk key=value): the starter gives the Logbook bean (logbook.*
             config; its inbound servlet filter is off in application.yml), logbook-spring the RestTemplate
             interceptor (blocking mode), logbook-spring-webflux the WebClient filter (webclient mode). -->
        <dependency>
            <groupId>org.zalando</groupId>
            <artifactId>logbook-spring-boot-starter</artifactId>
            <version>${logbook.version}</version>
        </dependency>
        <dependency>
            <groupId>org.zalando</groupId>
            <artifactId>logbook-spring</artifactId>
            <version>${logbook.version}</version>
        </dependency>
        <dependency>
            <groupId>org.zalando</groupId>
            <artifactId>logbook-spring-webflux</artifactId>
            <version>${logbook.version}</version>
        </dependency>

        <!-- Circuit breaker around the business RestTemplate (DownstreamCaller). The Spring Cloud starter keeps the
             resilience4j version on the Spring Cloud BOM's (2.3.0) and brings resilience4j-spring-boot3, which binds
             resilience4j.circuitbreaker.instances.* into a CircuitBreakerRegistry. Used directly, not through
             Spring Cloud's CircuitBreakerFactory, whose TimeLimiter (1 s, own thread) would change the calls. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- HealthCheckMdc: carries the probe round's MDC to the threads a WebClient probe is logged on
             (Reactor's automatic context propagation needs it on the classpath). Boot-managed. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
