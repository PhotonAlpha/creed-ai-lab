<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.creed</groupId>
        <artifactId>creed-resource</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>creed-resource-lb-health</artifactId>
    <name>creed-resource-lb-health</name>
    <description>
        Spring Cloud LoadBalancer health-check lab: get() must only ever return a complete round's list.
        The app is both the client and its own 10 target instances (extra Tomcat connectors).
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Only for the optional `webclient` health-check mode (withHealthChecks(WebClient), concurrent
             non-blocking probes). The servlet stack still wins the web-application-type detection, and
             without spring-boot-webclient there is no WebClient.Builder bean, so nothing reactive is
             auto-configured. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
