<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.creed</groupId>
        <artifactId>creed-resource</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>creed-resource-veracode</artifactId>
    <name>creed-resource-veracode</name>
    <description>Veracode report analysis — reads an uploaded Veracode XML report, matches it against Jira, creates the missing issues</description>

    <properties>
        <!-- Neither is managed by the Boot BOM. POI matches creed-report's pin, Logbook creed-simple-metrics'
             (4.x is the Boot 4 / Jackson 3 line). -->
        <poi.version>5.4.1</poi.version>
        <logbook.version>4.2.0</logbook.version>
        <!-- not in the Boot BOM; 3.0.0 is POI 5 + JEXL 3.3 (the poi-ooxml pinned above wins) -->
        <jxls.version>3.0.0</jxls.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- the Confluence export page (templates/confluence-report.html), rendered to a string - no MVC views -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- Spring Boot 4 moved RestClient/RestTemplate support (the RestClient.Builder bean) out of
             spring-boot-starter-web into its own starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!-- The Jira RestClient's transport (HttpComponentsClientHttpRequestFactory); version from the Boot BOM. -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <!-- Jira request/response log: the starter gives the Logbook bean (logbook.* config), logbook-httpclient5
             the exec handler on the Jira client. Its inbound servlet filter is switched off in application.yml. -->
        <dependency>
            <groupId>org.zalando</groupId>
            <artifactId>logbook-spring-boot-starter</artifactId>
            <version>${logbook.version}</version>
        </dependency>
        <dependency>
            <groupId>org.zalando</groupId>
            <artifactId>logbook-httpclient5</artifactId>
            <version>${logbook.version}</version>
        </dependency>

        <!-- Excel (.xlsx) export: poi-ooxml pulls in poi + the OOXML schemas. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Report templates (asked for, 2026-11-12): a company .xlsx, its cells bound to SCA / SAST fields, written
             back with JXLS markup and filled at export. -->
        <dependency>
            <groupId>org.jxls</groupId>
            <artifactId>jxls-poi</artifactId>
            <version>${jxls.version}</version>
        </dependency>
        <!-- ... kept in a database: an H2 file under the working directory by default, PostgreSQL with the
             `postgres` profile. The starter, not bare flyway-core: Boot 4 moved Flyway's auto-configuration into
             spring-boot-flyway, and with flyway-core alone no migration ever runs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway 10+ ships each dialect separately ("Unsupported Database: PostgreSQL" without it). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

       <!-- <dependency>
            <groupId>com.creed</groupId>
            <artifactId>creed-common-metrics</artifactId>
        </dependency>-->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 split spring-boot-starter-test: MockMvc (and MockMvcClientHttpRequestFactory's
             autoconfiguration) ships in its own module. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- the create-screen cache (veracode.jira.meta-cache-ttl); version from the Boot BOM -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
