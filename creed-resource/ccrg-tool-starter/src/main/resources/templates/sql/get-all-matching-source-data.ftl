SELECT T0.`KEY`, T0.`VALUE`, T0.SOURCE, T0.ORIGIN, T0.IS_ACTIVE
FROM (SELECT * FROM T_PROPERTIES) T0
LEFT JOIN (SELECT * FROM T_PROPERTIES WHERE SOURCE = 1) T1 ON T0.`KEY` = T1.`KEY`
LEFT JOIN (SELECT * FROM T_PROPERTIES WHERE SOURCE = 2) T2 ON T0.`KEY` = T2.`KEY`
<#if NUMBER_OF_SOURCES &gt; 2>
<#list 3..NUMBER_OF_SOURCES as i>
    LEFT JOIN (SELECT * FROM T_PROPERTIES WHERE SOURCE = ${i}) T${i} ON T0.`KEY` = T${i}.`KEY`
</#list>
</#if>
WHERE T1.`VALUE` = T2.`VALUE`
<#if NUMBER_OF_SOURCES &gt; 2>
<#list 3..NUMBER_OF_SOURCES as i>
    AND T1.`VALUE` = T${i}.`VALUE`
</#list>
</#if>
<#if ACTIVE_ONLY?? && ACTIVE_ONLY == true>
    AND T0.IS_ACTIVE = TRUE
</#if>
<#if KEY_FILTER?? && KEY_FILTER?has_content>
    AND T0.`KEY` LIKE '%${KEY_FILTER}%'
</#if>
ORDER BY T0.`KEY`
