+package com.creed.parent.service.report.alert;
+
+/**
+ * @author EthanCao
+ * @description ccrg-tool
+ * @date 2026-11-18
+ */
+public enum ConfigAlertRule {
+    /** An address names a different environment than the side's own (a PROD file pointing at uat1). */
+    FOREIGN_ENVIRONMENT("Another environment's address"),
+    /** A secret key whose value is neither {cipher}, ENC(...), a placeholder nor masked. */
+    PLAIN_SECRET("Unencrypted secret"),
+    /** A key on the watchlist differs between the two sides. */
+    WATCHED_KEY_CHANGED("Watched key changed");
+
+    private final String title;
+
+    ConfigAlertRule(String title) {
+        this.title = title;
+    }
+
+    public String getTitle() {
+        return title;
+    }
+}
