diff --git a/creed-resource/ccrg-tool-starter/src/main/resources/templates/fragments/origin-popover-script.html b/creed-resource/ccrg-tool-starter/src/main/resources/templates/fragments/origin-popover-script.html
new file mode 100644
index 00000000..6d7388f5
--- /dev/null
+++ b/creed-resource/ccrg-tool-starter/src/main/resources/templates/fragments/origin-popover-script.html
@@ -0,0 +1,87 @@
+<!--/*
+  Where a property line comes from (its "origin": file + line).
+  - hover: the native tooltip (th:title on the line) - no JS, never flickers, never covers other lines;
+  - click: pins ONE popover with the full origin and a Copy button; a second click, Esc, a click
+    elsewhere or switching tab closes it. Opening another line closes the previous one.
+
+  Replaces one bootstrap.Popover per line, created eagerly at load (thousands in a large report), with
+  trigger "click hover focus": hover opened it, clicking left it open, every click queued another 20 s
+  hide timer, and several popovers could stay open at once on top of the lines being read.
+  One delegated listener; the popover is created on demand and disposed when closed.
+*/-->
+<script th:fragment="originPopover">
+    (() => {
+        let open = null; // { el, pop }
+
+        const close = () => {
+            if (!open) return;
+            open.el.classList.remove('origin-open');
+            open.pop.dispose();
+            open = null;
+        };
+
+        const content = (origin) => {
+            const box = document.createElement('div');
+            box.className = 'd-flex align-items-start gap-2';
+            const text = document.createElement('code');
+            text.className = 'origin-text text-break';
+            text.textContent = origin;                  // text, never HTML
+            const copy = document.createElement('button');
+            copy.type = 'button';
+            copy.className = 'btn btn-sm btn-outline-secondary py-0 flex-shrink-0';
+            copy.innerHTML = '<i class="bi bi-clipboard"></i>';
+            copy.title = 'Copy';
+            copy.addEventListener('click', (e) => {
+                e.stopPropagation();
+                const done = () => { copy.innerHTML = '<i class="bi bi-check2"></i>'; };
+                // file:// and plain http have no Clipboard API, and it can also reject (no focus, no
+                // permission): select the text and use the legacy copy - the text stays selected for Ctrl+C.
+                const legacy = () => {
+                    const range = document.createRange();
+                    range.selectNodeContents(text);
+                    const sel = window.getSelection();
+                    sel.removeAllRanges();
+                    sel.addRange(range);
+                    try {
+                        if (document.execCommand('copy')) done();
+                    } catch (ignored) { /* left selected */ }
+                };
+                if (navigator.clipboard && window.isSecureContext) {
+                    // writeText can also stay pending (a permission decision nobody makes): give it 1 s
+                    let settled = false;
+                    const settle = (fn) => () => { if (!settled) { settled = true; fn(); } };
+                    navigator.clipboard.writeText(origin).then(settle(done), settle(legacy));
+                    setTimeout(settle(legacy), 1000);
+                } else {
+                    legacy();
+                }
+            });
+            box.append(text, copy);
+            return box;
+        };
+
+        document.addEventListener('click', (e) => {
+            if (e.target.closest('.popover')) return;   // clicks inside the popover (select / copy)
+            const el = e.target.closest('.code-content[data-origin]');
+            if (!el || !el.dataset.origin) { close(); return; }
+            if (open && open.el === el) { close(); return; }
+            close();
+            const pop = new bootstrap.Popover(el, {
+                trigger: 'manual',
+                container: 'body',
+                placement: 'top',
+                html: true,
+                sanitize: false,                        // content is a DOM node built with textContent
+                customClass: 'origin-popover',
+                title: '<i class="bi bi-file-earmark-code me-1"></i>Source',
+                content: content(el.dataset.origin),
+            });
+            pop.show();
+            el.classList.add('origin-open');
+            open = { el, pop };
+        });
+
+        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
+        document.addEventListener('shown.bs.tab', close);
+    })();
+</script>
