+package com.creed.parent.service.report.alert;
+
+import com.creed.parent.model.ReportDetails;
+import lombok.RequiredArgsConstructor;
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.stereotype.Service;
+
+import java.util.*;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+
+/**
+ * Flags the differences in a comparison that are dangerous rather than merely different. A plain diff
+ * gives a release bump and a PROD datasource pointing at UAT the same red/green weight; this tags them
+ * with a severity so the report can put them first.
+ * <p>
+ * Rules (all lists in {@link ConfigAlertProperties}):
+ * <ul>
+ *   <li>{@link ConfigAlertRule#FOREIGN_ENVIRONMENT} - critical, checked per side against that side's own environment;</li>
+ *   <li>{@link ConfigAlertRule#PLAIN_SECRET} - critical, per side;</li>
+ *   <li>{@link ConfigAlertRule#WATCHED_KEY_CHANGED} - the rule's severity, when the two sides differ.</li>
+ * </ul>
+ * Pure function of its input - no Spring context needed to test it.
+ *
+ * @author EthanCao
+ * @description ccrg-tool
+ * @date 2026-11-18
+ */
+@Service
+@RequiredArgsConstructor
+public class ConfigAlertService {
+
+    private static final Pattern TRAILING_DIGITS = Pattern.compile("\\d+$");
+    private static final Pattern NON_ALNUM = Pattern.compile("[^a-z0-9]+");
+
+    private final ConfigAlertProperties properties;
+
+    /**
+     * @param left  baseline properties, name -> value as rendered in the report
+     * @param right comparison properties
+     */
+    public List<ConfigAlert> evaluate(Map<String, String> left, Map<String, String> right,
+                                      ReportDetails leftDetails, ReportDetails rightDetails) {
+        if (!properties.isEnabled()) {
+            return List.of();
+        }
+        Rules rules = new Rules(properties);
+        String leftEnv = tier(leftDetails, rules.envTokens);
+        String rightEnv = tier(rightDetails, rules.envTokens);
+
+        SortedSet<String> keys = new TreeSet<>(left.keySet());
+        keys.addAll(right.keySet());
+
+        List<ConfigAlert> alerts = new ArrayList<>();
+        for (String key : keys) {
+            String l = left.get(key);
+            String r = right.get(key);
+            boolean secretKey = rules.isSecretKey(key);
+
+            // 1. another environment's address
+            if (rules.isAddress(key, l) || rules.isAddress(key, r)) {
+                String lHit = foreignToken(l, leftEnv, rules);
+                String rHit = foreignToken(r, rightEnv, rules);
+                if (lHit != null || rHit != null) {
+                    List<String> why = new ArrayList<>();
+                    if (lHit != null) why.add("Baseline is " + leftEnv.toUpperCase() + " but the value contains \"" + lHit + "\"");
+                    if (rHit != null) why.add("Comparison is " + rightEnv.toUpperCase() + " but the value contains \"" + rHit + "\"");
+                    alerts.add(alert(ConfigAlertSeverity.CRITICAL, ConfigAlertRule.FOREIGN_ENVIRONMENT, key,
+                            side(lHit != null, rHit != null), l, r, secretKey, String.join("; ", why) + "."));
+                }
+            }
+
+            // 2. plain-text secret
+            if (secretKey) {
+                boolean lPlain = rules.isPlainSecret(l);
+                boolean rPlain = rules.isPlainSecret(r);
+                if (lPlain || rPlain) {
+                    alerts.add(alert(ConfigAlertSeverity.CRITICAL, ConfigAlertRule.PLAIN_SECRET, key,
+                            side(lPlain, rPlain), l, r, true,
+                            "The key holds a secret and the value is not {cipher}…, ENC(…) or a ${…} placeholder."));
+                }
+            }
+
+            // 3. watchlist
+            if (!Objects.equals(l, r)) {
+                ConfigAlertProperties.WatchRule watch = rules.watchRule(key);
+                if (watch != null) {
+                    String detail = l == null ? "Not set in the baseline."
+                            : r == null ? "Not set in the comparison; the code default applies."
+                            : "Value changed.";
+                    String reason = StringUtils.isBlank(watch.getReason()) ? detail : watch.getReason() + " · " + detail;
+                    ConfigAlertSeverity severity = watch.getSeverity() == null ? ConfigAlertSeverity.HIGH : watch.getSeverity();
+                    alerts.add(alert(severity, ConfigAlertRule.WATCHED_KEY_CHANGED, key, "both", l, r, secretKey, reason));
+                }
+            }
+        }
+
+        for (ConfigAlert alert : alerts) {
+            ConfigAlertProperties.AcceptRule accept = rules.acceptRule(alert);
+            if (accept != null) {
+                alert.setSeverity(ConfigAlertSeverity.ACCEPTED);
+                alert.setAcceptedReason(StringUtils.defaultIfBlank(accept.getReason(), "Accepted difference"));
+            }
+        }
+        alerts.sort(Comparator.comparing(ConfigAlert::getSeverity)
+                .thenComparing(ConfigAlert::getKey)
+                .thenComparing(ConfigAlert::getRule));
+        return alerts;
+    }
+
+    /** The environment a side belongs to, as one of the tokens: "UAT" / "UAT1" -> uat. Null = unknown. */
+    static String tier(ReportDetails details, Set<String> envTokens) {
+        if (details == null) {
+            return null;
+        }
+        for (String candidate : new String[]{details.getEnvironment(), details.getInstance()}) {
+            if (StringUtils.isNotBlank(candidate)) {
+                String base = TRAILING_DIGITS.matcher(candidate.trim().toLowerCase(Locale.ROOT)).replaceFirst("");
+                if (envTokens.contains(base)) {
+                    return base;
+                }
+            }
+        }
+        return null;
+    }
+
+    /** The first token naming an environment other than {@code ownTier}, as written (uat1), or null. */
+    static String foreignToken(String value, String ownTier, Rules rules) {
+        if (ownTier == null || StringUtils.isBlank(value)) {
+            return null;
+        }
+        for (String token : NON_ALNUM.split(value.toLowerCase(Locale.ROOT))) {
+            String base = TRAILING_DIGITS.matcher(token).replaceFirst("");
+            if (!base.isEmpty() && rules.envTokens.contains(base) && !base.equals(ownTier)) {
+                return token;
+            }
+        }
+        return null;
+    }
+
+    private static String side(boolean left, boolean right) {
+        return left && right ? "both" : left ? "baseline" : "comparison";
+    }
+
+    private static ConfigAlert alert(ConfigAlertSeverity severity, ConfigAlertRule rule, String key, String side,
+                                     String l, String r, boolean mask, String reason) {
+        ConfigAlert alert = new ConfigAlert();
+        alert.setSeverity(severity);
+        alert.setRule(rule);
+        alert.setKey(key);
+        alert.setSide(side);
+        alert.setLeftValue(mask ? mask(l) : l);
+        alert.setRightValue(mask ? mask(r) : r);
+        alert.setReason(reason);
+        return alert;
+    }
+
+    /** Never put a secret in the Alerts tab: only its length, and whether it is protected. */
+    static String mask(String value) {
+        if (value == null) {
+            return null;
+        }
+        if (value.isEmpty()) {
+            return "";
+        }
+        if (value.startsWith("{cipher}")) return "{cipher}…";
+        if (value.startsWith("ENC(")) return "ENC(…)";
+        if (value.startsWith("${")) return value;
+        return "•••••••• (" + value.length() + " chars, plain text)";
+    }
+
+    /** The configured lists, compiled once per evaluation. */
+    static final class Rules {
+        final Set<String> envTokens;
+        private final List<Pattern> addressKeys;
+        private final List<Pattern> secretKeys;
+        private final List<Pattern> secretKeyExcludes;
+        private final List<Pattern> protectedValues;
+        private final List<Map.Entry<Pattern, ConfigAlertProperties.WatchRule>> watchlist;
+        private final List<Map.Entry<Pattern, ConfigAlertProperties.AcceptRule>> accepted;
+
+        Rules(ConfigAlertProperties p) {
+            envTokens = p.getEnvironmentTokens().stream().map(t -> t.toLowerCase(Locale.ROOT)).collect(Collectors.toSet());
+            addressKeys = globs(p.getAddressKeys());
+            secretKeys = globs(p.getSecretKeys());
+            secretKeyExcludes = globs(p.getSecretKeyExcludes());
+            protectedValues = p.getProtectedValuePatterns().stream().map(Pattern::compile).toList();
+            watchlist = p.getWatchlist().stream().filter(w -> StringUtils.isNotBlank(w.getKey()))
+                    .map(w -> Map.entry(glob(w.getKey()), w)).toList();
+            accepted = p.getAccepted().stream().filter(a -> StringUtils.isNotBlank(a.getKey()))
+                    .map(a -> Map.entry(glob(a.getKey()), a)).toList();
+        }
+
+        boolean isAddress(String key, String value) {
+            return value != null && (matchesAny(addressKeys, key) || value.contains("://"));
+        }
+
+        boolean isSecretKey(String key) {
+            return matchesAny(secretKeys, key) && !matchesAny(secretKeyExcludes, key);
+        }
+
+        boolean isPlainSecret(String value) {
+            if (StringUtils.isBlank(value)) {
+                return false;
+            }
+            String v = value.trim();
+            return protectedValues.stream().noneMatch(p -> p.matcher(v).matches());
+        }
+
+        ConfigAlertProperties.WatchRule watchRule(String key) {
+            return watchlist.stream().filter(e -> e.getKey().matcher(key).matches())
+                    .map(Map.Entry::getValue).findFirst().orElse(null);
+        }
+
+        ConfigAlertProperties.AcceptRule acceptRule(ConfigAlert alert) {
+            return accepted.stream()
+                    .filter(e -> e.getKey().matcher(alert.getKey()).matches())
+                    .filter(e -> e.getValue().getRule() == null || e.getValue().getRule() == alert.getRule())
+                    .map(Map.Entry::getValue).findFirst().orElse(null);
+        }
+
+        private static boolean matchesAny(List<Pattern> patterns, String key) {
+            return patterns.stream().anyMatch(p -> p.matcher(key).matches());
+        }
+
+        private static List<Pattern> globs(List<String> globs) {
+            return globs.stream().filter(StringUtils::isNotBlank).map(Rules::glob).toList();
+        }
+
+        /** {@code *} = any characters, everything else literal; case-insensitive, whole name. */
+        static Pattern glob(String glob) {
+            String regex = Arrays.stream(glob.trim().split("\\*", -1)).map(Pattern::quote).collect(Collectors.joining(".*"));
+            return Pattern.compile(regex, Pattern.CASE_INSENSITIVE);
+        }
+    }
+}
