+package com.creed.parent.service.report.alert;
+
+import lombok.Data;
+import org.springframework.boot.context.properties.ConfigurationProperties;
+import org.springframework.context.annotation.Configuration;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * {@code ccrg.alerts.*}: the rules behind the report's Alerts tab. Every list is data so a new critical
+ * key is a yml change, not a release. A list set in yml REPLACES the default here (Spring binds lists
+ * whole) - copy the defaults when extending one.
+ * <p>
+ * Key patterns are globs over the full property name, case-insensitive: {@code *} = any characters.
+ *
+ * @author EthanCao
+ * @description ccrg-tool
+ * @date 2026-11-18
+ */
+@Configuration
+@ConfigurationProperties(prefix = "ccrg.alerts")
+@Data
+public class ConfigAlertProperties {
+
+    private boolean enabled = true;
+
+    /**
+     * Environment names as they appear inside host names / URLs. A value is checked token by token
+     * ({@code pgdb-uat1.sg.internal} -> pgdb, uat1, sg, internal), trailing digits dropped, so
+     * {@code uat1} counts as {@code uat} but {@code product} never counts as {@code prod}.
+     */
+    private List<String> environmentTokens = new ArrayList<>(List.of(
+            "dev", "sit", "uat", "pt", "perf", "preprod", "staging", "prod", "dr"));
+
+    /** Keys whose value is an address; any value containing {@code ://} is one as well. */
+    private List<String> addressKeys = new ArrayList<>(List.of(
+            "*url", "*uri", "*host", "*hosts", "*endpoint", "*endpoints", "*address", "*addresses",
+            "*bootstrap-servers", "*nodes"));
+
+    /** Keys that hold a secret... */
+    private List<String> secretKeys = new ArrayList<>(List.of(
+            "*password*", "*passwd*", "*secret*", "*token*", "*credential*", "*private-key*",
+            "*api-key*", "*apikey*"));
+
+    /** ...unless they also match one of these (a token URL or a token lifetime is no secret). */
+    private List<String> secretKeyExcludes = new ArrayList<>(List.of(
+            "*url", "*uri", "*endpoint", "*path", "*header*", "*name", "*type", "*enabled",
+            "*seconds", "*timeout*", "*ttl*", "*validity*", "*expir*", "*length", "*size", "*policy*"));
+
+    /** Regexes for a secret value that is NOT plain text: encrypted, a placeholder, or masked. */
+    private List<String> protectedValuePatterns = new ArrayList<>(List.of(
+            "^\\{cipher\\}.+", "^ENC\\(.+\\)$", "^\\$\\{[^}]+\\}$", "^\\*+$"));
+
+    /** A watched key raises its severity whenever the two sides differ, a missing side included. */
+    private List<WatchRule> watchlist = new ArrayList<>(List.of(
+            new WatchRule("spring.datasource.*", ConfigAlertSeverity.HIGH, "Database connection settings"),
+            new WatchRule("spring.profiles.active", ConfigAlertSeverity.HIGH, "Changes which profile files load"),
+            new WatchRule("server.port", ConfigAlertSeverity.HIGH, "Listening port"),
+            new WatchRule("server.ssl.*", ConfigAlertSeverity.HIGH, "TLS settings"),
+            new WatchRule("logging.level.root", ConfigAlertSeverity.HIGH, "Root log level"),
+            new WatchRule("*url", ConfigAlertSeverity.HIGH, "Address of another system"),
+            new WatchRule("*host", ConfigAlertSeverity.HIGH, "Address of another system")));
+
+    /** Expected differences: matching alerts still show, under "Accepted", and stop counting as alerts. */
+    private List<AcceptRule> accepted = new ArrayList<>();
+
+    @Data
+    public static class WatchRule {
+        private String key;
+        private ConfigAlertSeverity severity = ConfigAlertSeverity.HIGH;
+        private String reason;
+
+        public WatchRule() {
+        }
+
+        public WatchRule(String key, ConfigAlertSeverity severity, String reason) {
+            this.key = key;
+            this.severity = severity;
+            this.reason = reason;
+        }
+    }
+
+    @Data
+    public static class AcceptRule {
+        /** Glob over the property name. */
+        private String key;
+        /** Optional: only this rule ({@link ConfigAlertRule} name); blank = any rule. */
+        private ConfigAlertRule rule;
+        /** Shown next to the accepted alert, e.g. who accepted it and why. */
+        private String reason;
+    }
+}
