+            p.setSourceName("Config resource 'file [/repo/application.yml]'");
+            list.add(p);
+        });
+        return new EnvironmentConfigurationVo(profile, list);
+    }
+
+    private void answer(Map<String, EnvironmentConfigurationVo> byInstance) {
+        when(inspection.getAllProperties(anyString(), any(RouteDefinition.class), anyInt()))
+                .thenAnswer(inv -> byInstance.get(inv.getArgument(1, RouteDefinition.class).getInstance()));
+    }
+
+    @Test
+    void laterSourceWinsAndEveryDisagreementIsReported() {
+        Map<String, String> one = new LinkedHashMap<>();
+        one.put("server.port", "8080");
+        one.put("only.first", "a");
+        one.put("same.everywhere", "x");
+        one.put("db.url", "jdbc:one");
+        Map<String, String> two = new LinkedHashMap<>();
+        two.put("server.port", "9090");
+        two.put("same.everywhere", "x");
+        two.put("only.second", "${MISSING}");
+        Map<String, String> three = new LinkedHashMap<>();
+        three.put("db.url", "jdbc:three");
+        answer(Map.of("UAT1", config("uat", one), "UAT2", config("uat,ext", two), "UAT3", config("dr", three)));
+
+        EffectiveYamlVo vo = service.generate(List.of(route("UAT1"), route("UAT2"), route("UAT3")));
+
+        assertThat(vo.propertyCount()).isEqualTo(5);
+        assertThat(vo.yaml())
+                .contains("port: 9090").doesNotContain("port: 8080")
+                .contains("url: jdbc:three")
+                .contains("first: a")
+                .contains("# merged from 3 sources")
+                .contains("# [2] idbproxy/R1 · SG · ccs · UAT · UAT2 (spring.profiles.active: uat,ext, 3 properties)")
+                .contains("2 overridden with a different value");
+        assertThat(vo.conflicts()).containsExactly(
+                new EffectiveYamlVo.Conflict("db.url", 3, Arrays.asList("jdbc:one", null, "jdbc:three")),
+                new EffectiveYamlVo.Conflict("server.port", 2, Arrays.asList("8080", "9090", null)));
+        assertThat(vo.unresolved()).containsExactly("only.second");
+        assertThat(vo.activeProfiles()).isEqualTo("uat | uat,ext | dr");
+        assertThat(vo.sources()).extracting(EffectiveYamlVo.Source::propertyCount).containsExactly(4, 3, 1);
+        assertThat(vo.fileName()).isEqualTo("merged-idbproxy-R1-SG-ccs-UAT-UAT1-and-2-more.yml");
+    }
+
+    @Test
+    void singleSourceKeepsTheOldShape() {
+        answer(Map.of("UAT1", config("uat", Map.of("a.b", "1"))));
+        EffectiveYamlVo vo = service.generate(route("UAT1"));
+        assertThat(vo.fileName()).isEqualTo("idbproxy-R1-SG-ccs-UAT-UAT1.yml");
+        assertThat(vo.conflicts()).isEmpty();
+        assertThat(vo.yaml()).contains("# source: idbproxy/R1").doesNotContain("merged");
+    }
+
+    @Test
+    void anIncompleteSourceIsRejectedBeforeAnythingLoads() {
+        RouteInfoVo broken = route("UAT2");
+        broken.setApp(null);
+        assertThatThrownBy(() -> service.generate(List.of(route("UAT1"), broken)))
+                .isInstanceOf(ServiceException.class)
+                .hasMessageContaining("source 2 missing: app");
+        verify(inspection, never()).getAllProperties(anyString(), any(), anyInt());
+    }
+}
diff --git a/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/service/report/ConfigAlertServiceTest.java b/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/service/report/ConfigAlertServiceTest.java
new file mode 100644
index 00000000..b25b61d7
--- /dev/null
+++ b/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/service/report/ConfigAlertServiceTest.java
@@ -0,0 +1,120 @@
+package com.creed.parent.service.report;
+
+import com.creed.parent.model.ReportDetails;
+import com.creed.parent.service.report.alert.ConfigAlert;
+import com.creed.parent.service.report.alert.ConfigAlertProperties;
+import com.creed.parent.service.report.alert.ConfigAlertRule;
+import com.creed.parent.service.report.alert.ConfigAlertService;
+import com.creed.parent.service.report.alert.ConfigAlertSeverity;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class ConfigAlertServiceTest {
+
+    private final ConfigAlertProperties props = new ConfigAlertProperties();
+    private final ConfigAlertService service = new ConfigAlertService(props);
+
+    private static ReportDetails env(String env, String instance) {
+        ReportDetails d = new ReportDetails();
+        d.setEnvironment(env);
+        d.setInstance(instance);
+        return d;
+    }
+
+    private List<ConfigAlert> run(Map<String, String> left, Map<String, String> right) {
+        return service.evaluate(left, right, env("PROD", "PROD1"), env("PROD", "PROD1"));
+    }
+
+    private static ConfigAlert only(List<ConfigAlert> alerts, ConfigAlertRule rule) {
+        List<ConfigAlert> found = alerts.stream().filter(a -> a.getRule() == rule).toList();
+        assertThat(found).hasSize(1);
+        return found.get(0);
+    }
+
+    @Test
+    void prodPointingAtUatIsCriticalButProductIsNotProd() {
+        List<ConfigAlert> alerts = run(
+                Map.of("spring.datasource.url", "jdbc:postgresql://pgdb-prod.sg.internal:5432/idb",
+                        "catalog.product.base-url", "https://product-api.sg.internal",
+                        "app.name", "uat-like-name"),
+                Map.of("spring.datasource.url", "jdbc:postgresql://pgdb-uat1.sg.internal:5432/idb",
+                        "catalog.product.base-url", "https://product-api.sg.internal",
+                        "app.name", "uat-like-name"));
+
+        ConfigAlert foreign = only(alerts, ConfigAlertRule.FOREIGN_ENVIRONMENT);
+        assertThat(foreign.getKey()).isEqualTo("spring.datasource.url");
+        assertThat(foreign.getSeverity()).isEqualTo(ConfigAlertSeverity.CRITICAL);
+        assertThat(foreign.getSide()).isEqualTo("comparison");
+        assertThat(foreign.getReason()).contains("PROD").contains("\"uat1\"");
+        // app.name is not an address; "product" is not "prod"; and the datasource is also watched
+        assertThat(alerts).extracting(ConfigAlert::getKey).doesNotContain("app.name", "catalog.product.base-url");
+        assertThat(only(alerts, ConfigAlertRule.WATCHED_KEY_CHANGED).getKey()).isEqualTo("spring.datasource.url");
+        assertThat(alerts.get(0).getSeverity()).isEqualTo(ConfigAlertSeverity.CRITICAL);
+    }
+
+    @Test
+    void unknownEnvironmentSkipsTheEnvironmentCheck() {
+        List<ConfigAlert> alerts = service.evaluate(Map.of("a.url", "http://x-uat.internal"), Map.of("a.url", "http://x-uat.internal"),
+                env("LAB", null), env(null, null));
+        assertThat(alerts).isEmpty();
+    }
+
+    @Test
+    void plainSecretIsCriticalAndMaskedEncryptedOrPlaceholderIsFine() {
+        Map<String, String> left = new HashMap<>(Map.of(
+                "spring.datasource.password", "{cipher}AQB3f9a",
+                "jwt.token-validity-seconds", "3600",
+                "oauth.token-url", "https://auth.prod.internal/token",
+                "client.secret", "ENC(abc)",
+                "api.key-store.password", "${KEYSTORE_PASSWORD}"));
+        Map<String, String> right = new HashMap<>(left);
+        right.put("spring.datasource.password", "Prod#2026!");
+
+        List<ConfigAlert> alerts = run(left, right);
+        ConfigAlert secret = only(alerts, ConfigAlertRule.PLAIN_SECRET);
+        assertThat(secret.getKey()).isEqualTo("spring.datasource.password");
+        assertThat(secret.getSide()).isEqualTo("comparison");
+        assertThat(secret.getLeftValue()).isEqualTo("{cipher}…");
+        assertThat(secret.getRightValue()).doesNotContain("Prod#2026!").contains("10 chars");
+        // the watched-key alert for the same key must not leak the value either
+        assertThat(only(alerts, ConfigAlertRule.WATCHED_KEY_CHANGED).getRightValue()).doesNotContain("Prod#2026!");
+    }
+
+    @Test
+    void watchedKeyMissingOnOneSideAndUnwatchedChangeIsIgnored() {
+        List<ConfigAlert> alerts = run(
+                Map.of("notification.smtp.host", "smtp.sg.internal", "logging.level.root", "INFO", "cache.ttl", "600"),
+                Map.of("logging.level.root", "DEBUG", "cache.ttl", "60"));
+
+        assertThat(alerts).extracting(ConfigAlert::getKey).containsExactly("logging.level.root", "notification.smtp.host");
+        ConfigAlert missing = alerts.get(1);
+        assertThat(missing.getRightValue()).isNull();
+        assertThat(missing.getReason()).contains("Not set in the comparison");
+        assertThat(missing.getSeverity()).isEqualTo(ConfigAlertSeverity.HIGH);
+    }
+
+    @Test
+    void acceptedRuleKeepsTheAlertButStopsCountingIt() {
+        ConfigAlertProperties.AcceptRule accept = new ConfigAlertProperties.AcceptRule();
+        accept.setKey("logging.level.*");
+        accept.setReason("Debug window for incident 4711");
+        props.setAccepted(List.of(accept));
+
+        List<ConfigAlert> alerts = run(Map.of("logging.level.root", "INFO"), Map.of("logging.level.root", "DEBUG"));
+        assertThat(alerts).singleElement().satisfies(a -> {
+            assertThat(a.getSeverity()).isEqualTo(ConfigAlertSeverity.ACCEPTED);
+            assertThat(a.getAcceptedReason()).isEqualTo("Debug window for incident 4711");
+        });
+    }
+
+    @Test
+    void disabledReturnsNothing() {
+        props.setEnabled(false);
+        assertThat(run(Map.of("a.password", "x"), Map.of())).isEmpty();
+    }
+}
diff --git a/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/service/report/HtmlReportAlertsRenderTest.java b/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/service/report/HtmlReportAlertsRenderTest.java
new file mode 100644
index 00000000..c4aed779
--- /dev/null
+++ b/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/service/report/HtmlReportAlertsRenderTest.java
@@ -0,0 +1,137 @@
+package com.creed.parent.service.report;
+
+import com.creed.parent.constant.ReportTypeEnum;
+import com.creed.parent.controller.vo.EnvironmentConfigurationVo;
+import com.creed.parent.controller.vo.PropertiesVo;
+import com.creed.parent.definition.RouteDefinition;
+import com.creed.parent.service.DiffService;
+import com.creed.parent.service.report.alert.ConfigAlertProperties;
+import com.creed.parent.service.report.alert.ConfigAlertService;
+import com.creed.parent.service.report.impl.HTMLReportGeneratorImpl;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.thymeleaf.spring6.SpringTemplateEngine;
+import org.thymeleaf.templatemode.TemplateMode;
+import org.thymeleaf.templateresolver.ClassLoaderTemplateResolver;
+
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Renders the real report-html-export-index page (all fragments, inlined assets) from two in-memory
+ * sources and checks the Alerts tab and the Overall Comparison badges. The page is also written to
+ * {@code target/ccrg-alerts-report.html} to look at.
+ */
+class HtmlReportAlertsRenderTest {
+
+    private static final String SECRET = "Prod#2026!";
+
+    private static EnvironmentConfigurationVo source(int source, String release, Map<String, String> props, Map<String, String> files) {
+        List<PropertiesVo> list = new ArrayList<>();
+        props.forEach((k, v) -> {
+            PropertiesVo p = new PropertiesVo();
+            p.setPropertyName(k);
+            p.setPropertyValue(v);
+            p.setOrigin("URL [file:/opt/ccrg/repo/idbproxy/" + release + "/SG/ccs/"
+                    + files.getOrDefault(k, "application-PROD.yml") + "] - " + (list.size() + 3) + ":5");
+            p.setSource(source);
+            p.setActive(true);
+            list.add(p);
+        });
+        RouteDefinition route = new RouteDefinition();
+        route.setReleaseName(release);
+        route.setCountryCode("SG");
+        route.setEnvironment("PROD");
+        route.setInstance("PROD1");
+        EnvironmentConfigurationVo vo = new EnvironmentConfigurationVo("PROD", list);
+        vo.setSource(source);
+        vo.setRouteDefinition(route);
+        return vo;
+    }
+
+    @Test
+    void reportShowsAlertsTabBannerAndRowBadges() throws Exception {
+        Map<String, String> r1 = new LinkedHashMap<>();
+        r1.put("app.name", "idbproxy");
+        r1.put("app.version", "1.4.0");
+        r1.put("cache.ttl", "600");
+        r1.put("feature.new-checkout.enabled", "false");
+        r1.put("logging.level.root", "INFO");
+        r1.put("notification.smtp.host", "smtp.sg.internal");
+        r1.put("payment.api.base-url", "https://pay.sg.internal/api");
+        r1.put("server.port", "8443");
+        r1.put("server.ssl.enabled", "true");
+        r1.put("spring.datasource.hikari.maximum-pool-size", "50");
+        r1.put("spring.datasource.password", "{cipher}AQB3f9a7c1d2e3");
+        r1.put("spring.datasource.url", "jdbc:postgresql://pgdb-prod.sg.internal:5432/idb");
+        r1.put("spring.datasource.username", "idb_app");
+        r1.put("upstream.timeout-ms", "3000");
+
+        Map<String, String> r2 = new LinkedHashMap<>(r1);
+        r2.put("app.version", "1.5.0");
+        r2.put("feature.new-checkout.enabled", "true");
+        r2.put("logging.level.root", "DEBUG");
+        r2.remove("notification.smtp.host");
+        r2.put("payment.api.base-url", "http://pay.sg.internal/api");
+        r2.put("server.ssl.enabled", "false");
+        r2.put("spring.datasource.hikari.maximum-pool-size", "5");
+        r2.put("spring.datasource.password", SECRET);
+        r2.put("spring.datasource.url", "jdbc:postgresql://pgdb-uat1.sg.internal:5432/idb");
+        r2.put("upstream.gateway.url", "https://gw.sit2.sg.internal");
+
+        ConfigAlertProperties alertProps = new ConfigAlertProperties();
+        ConfigAlertProperties.AcceptRule accept = new ConfigAlertProperties.AcceptRule();
+        accept.setKey("server.ssl.*");
+        accept.setReason("TLS terminates at the load balancer from R2 (CHG-1182)");
+        alertProps.setAccepted(List.of(accept));
+
+        HTMLReportGeneratorImpl generator = new HTMLReportGeneratorImpl();
+        ReflectionTestUtils.setField(generator, "templateEngine", templateEngine());
+        ReflectionTestUtils.setField(generator, "diffService", new DiffService());
+        ReflectionTestUtils.setField(generator, "applicationEventPublisher", (org.springframework.context.ApplicationEventPublisher) e -> { });
+        AssetService assets = new AssetService();
+        ReflectionTestUtils.invokeMethod(assets, "load");
+        ReflectionTestUtils.setField(generator, "assetService", assets);
+        ReflectionTestUtils.setField(generator, "configAlertService", new ConfigAlertService(alertProps));
+
+        ReportMetadataInfo metadata = new ReportMetadataInfo();
+        metadata.setConnectionId("test");
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        generator.generateReport(List.of(source(1, "R1", r1, Map.of()), source(2, "R2", r2, Map.of())),
+                ReportTypeEnum.HTML, Locale.ENGLISH, metadata, out);
+        String html = out.toString(StandardCharsets.UTF_8);
+        Files.writeString(Path.of("target", "ccrg-alerts-report.html"), html);
+
+        assertThat(html).contains("data-bs-target=\"#divAlerts\"", "id=\"divAlerts\"", "Review alerts");
+        assertThat(html).contains("Another environment&#39;s address", "Unencrypted secret", "Watched key changed");
+        // the datasource url row and the gateway url row carry a critical badge in the Overall tab
+        assertThat(html).contains("cfg-alert-row cfg-row-critical");
+        assertThat(html).contains("data-row=\"");
+        assertThat(html).contains("Accepted: TLS terminates at the load balancer");
+        // the plain password is masked in the Alerts tab: its only occurrences are the diff lines
+        String alertsTab = html.substring(html.indexOf("id=\"divAlerts\""), html.indexOf("id=\"div3\""));
+        assertThat(alertsTab).doesNotContain(SECRET).contains("10 chars, plain text");
+        // old eager popover attributes are gone from the overall fragment
+        assertThat(html).doesNotContain("data-bs-trigger=\"click hover focus\"");
+    }
+
+    private static SpringTemplateEngine templateEngine() {
+        ClassLoaderTemplateResolver resolver = new ClassLoaderTemplateResolver();
+        resolver.setPrefix("templates/");
+        resolver.setSuffix(".html");
+        resolver.setTemplateMode(TemplateMode.HTML);
+        resolver.setCharacterEncoding("UTF-8");
+        SpringTemplateEngine engine = new SpringTemplateEngine();
+        engine.setTemplateResolver(resolver);
+        return engine;
+    }
+}
diff --git a/creed-resource/scripts/conf/pdf/css/style.css b/creed-resource/scripts/conf/pdf/css/style.css
