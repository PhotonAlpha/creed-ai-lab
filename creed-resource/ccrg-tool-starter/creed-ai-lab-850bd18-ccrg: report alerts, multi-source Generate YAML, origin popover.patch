+<!--/*@thymesVar id="reportPropertiesOverview" type="com.creed.parent.controller.vo.ReportPropertiesOverviewVo"*/-->
+<!DOCTYPE html>
+<html lang="en" xmlns:th="http://www.thymeleaf.org">
+<!--/*
+  Alerts tab: the differences that are dangerous, not merely different (ConfigAlertService), most severe
+  first. Values are display text from the service - a secret arrives masked. "Show line" opens the
+  Overall Comparison tab at the property's row (ConfigAlert#overallRow).
+*/-->
+<div th:fragment="alertsHtml"
+     th:with="ov=${reportPropertiesOverview},alerts=${reportPropertiesOverview?.alerts},left=${reportPropertiesOverview?.overallPropertiesOverview?.leftPropertyReview?.reportDetails},right=${reportPropertiesOverview?.overallPropertiesOverview?.rightPropertyReview?.reportDetails}">
+
+    <div class="d-flex flex-wrap gap-2 mb-3">
+        <div class="cfg-stat cfg-sev-critical">
+            <b th:text="${ov.criticalCount}">0</b><span>Critical</span>
+        </div>
+        <div class="cfg-stat cfg-sev-high">
+            <b th:text="${ov.highCount}">0</b><span>High</span>
+        </div>
+        <div class="cfg-stat cfg-sev-accepted">
+            <b th:text="${ov.acceptedCount}">0</b><span>Accepted</span>
+        </div>
+        <div class="small text-muted align-self-center ms-auto">
+            Baseline <span class="fw-semibold" th:text="|${left?.releaseName} · ${left?.environment} ${left?.instance}|"></span>
+            → comparison <span class="fw-semibold" th:text="|${right?.releaseName} · ${right?.environment} ${right?.instance}|"></span>
+        </div>
+    </div>
+
+    <div class="alert alert-success" th:if="${#lists.isEmpty(alerts)}">
+        <i class="bi bi-check-circle me-1"></i>No alerts: no address of another environment, no plain-text secret,
+        and no watched key differs.
+    </div>
+
+    <div class="cfg-alert-list" th:unless="${#lists.isEmpty(alerts)}">
+        <div th:each="a : ${alerts}" th:class="|cfg-alert cfg-sev-${a.severity.css}|">
+            <div class="d-flex flex-wrap align-items-start gap-2">
+                <span th:class="|badge cfg-sev cfg-sev-${a.severity.css}|" th:text="${a.severity.label}"></span>
+                <span class="fw-semibold" th:text="${a.title}"></span>
+                <span class="badge text-bg-light border fw-normal" th:if="${a.side != 'both'}" th:text="${a.side}"></span>
+                <button type="button" class="btn btn-sm btn-outline-primary py-0 ms-auto cfg-show-line"
+                        th:if="${a.overallRow != null}" th:attr="data-row=${a.overallRow}">
+                    <i class="bi bi-arrow-right-short"></i>Show line
+                </button>
+            </div>
+            <div class="font-monospace small text-break mt-1" th:text="${a.key}"></div>
+            <dl class="cfg-values font-monospace small mb-1">
+                <dt th:text="${left?.releaseName ?: 'Baseline'}"></dt>
+                <dd th:class="${a.leftValue == null} ? 'text-muted fst-italic'" th:text="${a.leftValue ?: '(not set)'}"></dd>
+                <dt th:text="${right?.releaseName ?: 'Comparison'}"></dt>
+                <dd th:class="${a.rightValue == null} ? 'text-muted fst-italic'" th:text="${a.rightValue ?: '(not set)'}"></dd>
+            </dl>
+            <div class="small text-muted" th:text="${a.reason}"></div>
+            <div class="small text-success" th:if="${a.acceptedReason != null}">
+                <i class="bi bi-check2-circle me-1"></i><span th:text="|Accepted: ${a.acceptedReason}|"></span>
+            </div>
+        </div>
+    </div>
+
+    <script>
+        (() => {
+            // One delegated handler: switch to the Overall tab, make sure the row is visible, scroll, flash.
+            document.addEventListener('click', (e) => {
+                const btn = e.target.closest('.cfg-show-line, .cfg-open-alerts');
+                if (!btn) return;
+                if (btn.classList.contains('cfg-open-alerts')) {
+                    const t = document.querySelector('[data-bs-target="#divAlerts"]');
+                    if (t) bootstrap.Tab.getOrCreateInstance(t).show();
+                    return;
+                }
+                const row = document.getElementById('overall-row-' + btn.dataset.row);
+                const tabBtn = document.querySelector('[data-bs-target="#div3"]');
+                if (!row || !tabBtn) return;
+                const table = document.getElementById('overallDiffTable');
+                const visible = () => getComputedStyle(row).display !== 'none';
+                const go = () => {
+                    if (!visible()) {
+                        table.classList.remove('overall-only-diff', 'overall-only-alerts');
+                        ['overallOnlyDiff', 'overallOnlyAlerts'].forEach(id => {
+                            const c = document.getElementById(id);
+                            if (c) c.checked = false;
+                        });
+                    }
+                    row.scrollIntoView({behavior: 'smooth', block: 'center'});
+                    row.classList.remove('cfg-flash');
+                    void row.offsetWidth;
+                    row.classList.add('cfg-flash');
+                };
+                if (tabBtn.classList.contains('active')) { go(); return; }
+                tabBtn.addEventListener('shown.bs.tab', go, {once: true});
+                bootstrap.Tab.getOrCreateInstance(tabBtn).show();
+            });
+        })();
+    </script>
+</div>
+</html>
