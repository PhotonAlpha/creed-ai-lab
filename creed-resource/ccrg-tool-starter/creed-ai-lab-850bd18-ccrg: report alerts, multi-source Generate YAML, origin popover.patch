+    static void markAlertRows(List<DiffDisplay> rows, List<String> leftKeys, List<String> rightKeys, List<ConfigAlert> alerts) {
+        if (alerts.isEmpty() || rows == null) {
+            return;
+        }
+        Map<String, List<ConfigAlert>> byKey = alerts.stream().collect(Collectors.groupingBy(ConfigAlert::getKey));
