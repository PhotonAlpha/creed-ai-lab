+    private static final Pattern LINE_KEY_MARKER = Pattern.compile(".*(?:: |- )k(\\d+)$");
+
+    /**
+     * The property on each line of {@code map2YamlConverter(properties)}: the same keys rendered with the
+     * values replaced by markers k0, k1, ... produce exactly the same lines (the origin YAML relies on the
+     * same parity), so line n of the marker YAML names the key of line n of the content.
+     */
+    static List<String> lineKeys(Collection<String> orderedKeys) {
+        List<String> keys = new ArrayList<>(orderedKeys);
+        Map<String, String> markers = new LinkedHashMap<>();
+        for (int i = 0; i < keys.size(); i++) {
+            markers.put(keys.get(i), "k" + i);
+        }
+        String yaml = PropertySourcesTranslateUtil.map2YamlConverter(markers);
+        List<String> result = new ArrayList<>();
+        for (String line : yaml.split(System.lineSeparator())) {
+            Matcher m = LINE_KEY_MARKER.matcher(line);
+            result.add(m.matches() ? keys.get(Integer.parseInt(m.group(1))) : null);
+        }
+        return result;
+    }
