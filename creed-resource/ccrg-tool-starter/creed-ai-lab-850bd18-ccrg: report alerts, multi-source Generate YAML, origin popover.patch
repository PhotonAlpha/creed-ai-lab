+
+
+/* Origin of a property line (fragments/origin-popover-script.html): hover = native tooltip, click = pinned popover. */
+.code-content[data-origin]:not([data-origin=""]) { cursor: pointer; }
+.code-content[data-origin]:not([data-origin=""]):hover { text-decoration: underline dotted; }
+.code-content.origin-open { outline: 2px solid var(--bs-primary); outline-offset: 1px; border-radius: 2px; }
+.origin-popover { --bs-popover-max-width: min(720px, 90vw); }
+.origin-popover .origin-text { font-size: .8125rem; user-select: all; }
+
+/* Configuration alerts (fragments/alerts-html-fragment.html, Overall Comparison badges). */
+.cfg-sev-critical { --cfg-c: var(--bs-danger-text-emphasis); --cfg-bg: var(--bs-danger-bg-subtle); --cfg-b: var(--bs-danger); }
+.cfg-sev-high { --cfg-c: var(--bs-warning-text-emphasis); --cfg-bg: var(--bs-warning-bg-subtle); --cfg-b: var(--bs-warning); }
+.cfg-sev-accepted { --cfg-c: var(--bs-success-text-emphasis); --cfg-bg: var(--bs-success-bg-subtle); --cfg-b: var(--bs-success); }
+.badge.cfg-sev { color: var(--cfg-c); background: var(--cfg-bg); border: 1px solid var(--cfg-b); font-weight: 600; }
+.cfg-stat { min-width: 110px; padding: .5rem .75rem; border: 1px solid var(--bs-border-color); border-left: 4px solid var(--cfg-b); border-radius: .375rem; }
+.cfg-stat b { display: block; font-size: 1.5rem; line-height: 1.2; color: var(--cfg-c); font-variant-numeric: tabular-nums; }
+.cfg-stat span { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: var(--bs-secondary-color); }
+.cfg-alert-list { display: flex; flex-direction: column; gap: .5rem; }
+.cfg-alert { padding: .625rem .75rem; border: 1px solid var(--bs-border-color); border-left: 4px solid var(--cfg-b); border-radius: .375rem; }
+.cfg-alert.cfg-sev-accepted { opacity: .75; }
+.cfg-values { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 0 .75rem; margin-top: .25rem; }
+.cfg-values dt { font-weight: 400; color: var(--bs-secondary-color); }
+.cfg-values dd { margin: 0; word-break: break-all; }
+tr.cfg-row-critical > td.blob-num { box-shadow: inset 3px 0 0 var(--bs-danger); }
+tr.cfg-row-high > td.blob-num { box-shadow: inset 3px 0 0 var(--bs-warning); }
+tr.cfg-flash > td { animation: cfg-flash 1.6s ease-out; }
+@keyframes cfg-flash { from { background-color: var(--bs-primary-bg-subtle); } }
+@media (prefers-reduced-motion: reduce) { tr.cfg-flash > td { animation: none; outline: 2px solid var(--bs-primary); } }
