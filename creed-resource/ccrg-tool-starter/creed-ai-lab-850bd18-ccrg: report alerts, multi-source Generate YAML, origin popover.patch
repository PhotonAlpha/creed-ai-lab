+package com.creed.parent.service.report.alert;
+
+/**
+ * Ordered most severe first: sorting by the enum puts the worst alerts on top.
+ *
+ * @author EthanCao
+ * @description ccrg-tool
+ * @date 2026-11-18
+ */
+public enum ConfigAlertSeverity {
+    CRITICAL("Critical"),
+    HIGH("High"),
+    /** Matched an {@code accepted} rule: shown, not counted. */
+    ACCEPTED("Accepted");
+
+    private final String label;
+
+    ConfigAlertSeverity(String label) {
+        this.label = label;
+    }
+
+    public String getLabel() {
+        return label;
+    }
+
+    /** CSS suffix used by the templates: {@code cfg-sev-critical} etc. */
+    public String getCss() {
+        return name().toLowerCase();
+    }
