@@ -0,0 +1,124 @@
+package com.creed.parent.service;
+
+import com.creed.parent.constant.GlobalErrorCodeConstants;
+import com.creed.parent.controller.prompt.vo.EffectiveYamlVo;
+import com.creed.parent.controller.vo.EnvironmentConfigurationVo;
+import com.creed.parent.controller.vo.PropertiesVo;
+import com.creed.parent.controller.vo.RouteInfoVo;
+import com.creed.parent.convert.PropertySourceConvert;
+import com.creed.parent.exception.ServiceException;
+import com.creed.parent.utils.PropertySourcesTranslateUtil;
+import jakarta.annotation.Resource;
+import lombok.extern.slf4j.Slf4j;
+import org.apache.commons.lang3.StringUtils;
+import org.apache.commons.lang3.exception.ExceptionUtils;
+import org.springframework.stereotype.Service;
+
+import java.time.OffsetDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.*;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+/**
+ * One source of the Batch form (project / release / country / app / environment / instance / zones) →
+ * the configuration that source would run with, as one .yml.
+ *
+ * <p>{@link EnvironmentInspectionService#getAllProperties(String, com.creed.parent.definition.RouteDefinition, int)}
+ * already answers the EFFECTIVE view - one entry per key, the property source with the highest precedence
+ * wins, placeholders resolved - so this only sorts it and renders it with
+ * {@link PropertySourcesTranslateUtil#map2YamlConverter}.
+ */
+@Service
+@Slf4j
+public class EffectiveYamlService {
+
+    private static final Map<String, Function<RouteInfoVo, String>> REQUIRED = new LinkedHashMap<>();
+
+    static {
+        REQUIRED.put("projectName", RouteInfoVo::getProjectName);
+        REQUIRED.put("countryCode", RouteInfoVo::getCountryCode);
+        REQUIRED.put("app", RouteInfoVo::getApp);
+        REQUIRED.put("environment", RouteInfoVo::getEnvironment);
+        REQUIRED.put("instance", RouteInfoVo::getInstance);
+    }
+
+    @Resource
+    private EnvironmentInspectionService environmentInspectionService;
+
+    public EffectiveYamlVo generate(RouteInfoVo route) {
+        List<String> missing = REQUIRED.entrySet().stream()
+                .filter(e -> route == null || StringUtils.isBlank(e.getValue().apply(route)))
+                .map(Map.Entry::getKey)
+                .toList();
+        if (!missing.isEmpty()) {
+            throw new ServiceException(GlobalErrorCodeConstants.BAD_REQUEST.code(), "missing: " + String.join(", ", missing));
+        }
+        // same sub-folder rule as EnvironmentInspectionService#getAllProperties(List)
+        String subFolder = StringUtils.isNotBlank(route.getReleaseName())
+                ? route.getProjectName() + "/" + route.getReleaseName()
+                : route.getProjectName();
+        EnvironmentConfigurationVo configuration;
+        try {
+            configuration = environmentInspectionService.getAllProperties(subFolder, PropertySourceConvert.INSTANCE.convert(route), 1);
+        } catch (RuntimeException e) {
+            // e.g. no Thymeleaf fragment for this project/app, or the release is not pulled - say which,
+            // instead of the handler's bare "Internal Server Error"
+            log.error("generate yaml {} failed", subFolder, e);
+            throw new ServiceException(GlobalErrorCodeConstants.INTERNAL_SERVER_ERROR.code(),
+                    "cannot load the configuration of " + subFolder + ": " + ExceptionUtils.getRootCauseMessage(e));
+        }
+
+        // sorted: the converter writes in iteration order, and a sorted file diffs cleanly against another source
+        Map<String, String> properties = Optional.ofNullable(configuration.getProperties()).orElse(List.of()).stream()
+                .filter(p -> !isOwnClasspath(p))
+                .collect(Collectors.toMap(PropertiesVo::getPropertyName,
+                        p -> Objects.toString(p.getPropertyValue(), ""), (first, second) -> first, TreeMap::new));
+        List<String> unresolved = properties.entrySet().stream()
+                .filter(e -> e.getValue().contains("${"))
+                .map(Map.Entry::getKey)
+                .toList();
+
+        String yaml = header(route, configuration.getActiveProfile(), properties.size(), unresolved.size())
+                + PropertySourcesTranslateUtil.map2YamlConverter(properties);
+        log.info("generate yaml {}: {} properties, {} unresolved", subFolder, properties.size(), unresolved.size());
+        return new EffectiveYamlVo(fileName(route), configuration.getActiveProfile(), properties.size(), unresolved, yaml);
+    }
+
+    /**
+     * The fragments' {@code spring.config.location} starts with {@code classpath:/} - and that classpath is
+     * ccrg-tool's OWN, not the inspected app's: its application.yml (tokens included) would be merged into
+     * the file the user downloads. Spring names such a source "... via location 'classpath:/'".
+     */
+    static boolean isOwnClasspath(PropertiesVo p) {
+        return StringUtils.contains(p.getSourceName(), "via location 'classpath:")
+                || StringUtils.startsWith(p.getSourceName(), "applicationConfig: [classpath:");
+    }
+
+    private static String header(RouteInfoVo r, String profiles, int count, int unresolved) {
+        StringBuilder sb = new StringBuilder()
+                .append("# Effective configuration - generated by ccrg-tool ")
+                .append(OffsetDateTime.now().format(DateTimeFormatter.ISO_OFFSET_DATE_TIME)).append('\n')
+                .append("# project: ").append(r.getProjectName())
+                .append(StringUtils.isNotBlank(r.getReleaseName()) ? " / " + r.getReleaseName() : "").append('\n')
+                .append("# country: ").append(r.getCountryCode())
+                .append(", app: ").append(r.getApp())
+                .append(", environment: ").append(r.getEnvironment())
+                .append(", instance: ").append(r.getInstance())
+                .append(", zone: ").append(StringUtils.defaultString(r.getZone())).append('\n')
+                .append("# spring.profiles.active: ").append(StringUtils.defaultString(profiles)).append('\n')
+                .append("# ").append(count).append(" properties");
+        if (unresolved > 0) {
+            sb.append(", ").append(unresolved).append(" with an unresolved ${...} placeholder");
+        }
+        return sb.append("\n\n").toString();
+    }
+
+    static String fileName(RouteInfoVo r) {
+        String base = Stream.of(r.getProjectName(), r.getReleaseName(), r.getCountryCode(), r.getApp(), r.getEnvironment(), r.getInstance())
+                .filter(StringUtils::isNotBlank)
+                .collect(Collectors.joining("-"));
+        return base.replaceAll("[^A-Za-z0-9._-]", "_") + ".yml";
+    }
+}
