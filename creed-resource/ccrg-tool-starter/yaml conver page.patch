+package com.creed.parent.controller.prompt.vo;
+
+import java.util.List;
+
+/**
+ * One source's effective configuration as a .yml.
+ *
+ * @param fileName       suggested download name
+ * @param activeProfiles the profiles Spring activated for the source, comma-joined
+ * @param propertyCount  properties in {@code yaml}
+ * @param unresolved     names whose value still holds a {@code ${...}} placeholder nothing defines
+ * @param yaml           header comment + the properties, nested
+ */
+public record EffectiveYamlVo(String fileName, String activeProfiles, int propertyCount, List<String> unresolved, String yaml) {
+}
diff --git a/creed-resource/ccrg-tool-starter/src/main/java/com/creed/parent/service/EffectiveYamlService.java b/creed-resource/ccrg-tool-starter/src/main/java/com/creed/parent/service/EffectiveYamlService.java
