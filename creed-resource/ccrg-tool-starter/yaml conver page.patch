+package com.creed.parent.utils;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.context.properties.source.ConfigurationPropertyName;
+import org.springframework.boot.env.YamlPropertySourceLoader;
+import org.springframework.core.env.EnumerablePropertySource;
+import org.springframework.core.io.ByteArrayResource;
+
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * The YAML must load back - with Spring's own loader - to exactly the properties it was made from.
+ * Names are compared as {@link ConfigurationPropertyName}s: {@code a.[x]} and {@code a[x]} are one name to Spring.
+ */
+class PropertySourcesTranslateUtilTest {
+
+    private static Map<ConfigurationPropertyName, String> canonical(Map<String, String> flat) {
+        Map<ConfigurationPropertyName, String> out = new LinkedHashMap<>();
+        flat.forEach((k, v) -> out.put(ConfigurationPropertyName.of(k), v));
+        return out;
+    }
+
+    private static Map<String, String> loadBack(String yaml) throws Exception {
+        Map<String, String> back = new LinkedHashMap<>();
+        for (var source : new YamlPropertySourceLoader().load("t", new ByteArrayResource(yaml.getBytes(StandardCharsets.UTF_8)))) {
+            var enumerable = (EnumerablePropertySource<?>) source;
+            for (String name : enumerable.getPropertyNames()) {
+                back.put(name, String.valueOf(enumerable.getProperty(name)));
+            }
+        }
+        return back;
+    }
+
+    private static void assertRoundTrip(Map<String, String> in) throws Exception {
+        String yaml = PropertySourcesTranslateUtil.map2YamlConverter(in);
+        assertThat(canonical(loadBack(yaml))).as(yaml).isEqualTo(canonical(in));
+    }
+
+    @Test
+    void everyCaseTheOldConverterGotWrongRoundTrips() throws Exception {
+        Map<String, String> in = new LinkedHashMap<>();
+        in.put("a", "parent-value");                      // was a.INVALID-KEY
+        in.put("a.b", "child");
+        in.put("app.version", "1.10");                    // was 1.1
+        in.put("app.flag", "on");                         // was true
+        in.put("app.nul", "null");                        // was empty
+        in.put("list[0]", "x");
+        in.put("list[2]", "z");                           // was list[1]
+        in.put("num.0.name", "zero");                     // was num[0].name
+        in.put("logging.level.[com.foo.Bar]", "DEBUG");   // was split on the dots
+        in.put("mixed", "m");                             // was merged into the list
+        in.put("mixed[0]", "m0");
+        assertRoundTrip(in);
+    }
+
+    @Test
+    void valuesThatNeedQuotingOrEscapingRoundTrip() throws Exception {
+        Map<String, String> in = new LinkedHashMap<>();
+        in.put("enc.password", "{cipher}AQB12xyz");
+        in.put("app.code", "0123");
+        in.put("app.sexagesimal", "8:30");
+        in.put("app.yes", "yes");
+        in.put("app.tilde", "~");
+        in.put("app.empty", "");
+        in.put("app.colon", "a: b");
+        in.put("app.hash", "x #y");
+        in.put("app.star", "*.example.com");
+        in.put("app.dash", "- item");
+        in.put("app.multiline", "line1\nline2");
+        in.put("app.lead", " padded");
+        in.put("app.placeholder", "${missing.key}");
+        in.put("app.long", "x".repeat(300));
+        in.put("app.unicode", "密码 ü");
+        assertRoundTrip(in);
+    }
+
+    @Test
+    void contiguousIndexesStayAYamlListAndSafeNumbersStayPlain() {
+        Map<String, String> in = new LinkedHashMap<>();
+        in.put("servers[0].host", "a");
+        in.put("servers[1].host", "b");
+        in.put("port", "8080");
+        in.put("enabled", "true");
+        in.put("version", "1.10");
+        assertThat(PropertySourcesTranslateUtil.map2YamlConverter(in)).isEqualTo("""
+                servers:
+                  - host: a
+                  - host: b
+                port: 8080
+                enabled: true
+                version: '1.10'
+                """);
+    }
+
+    @Test
+    void parentValueKeepsItsKeyAndChildrenAreDotted() {
+        Map<String, String> in = new LinkedHashMap<>();
+        in.put("spring.profiles", "uat");
+        in.put("spring.profiles.active", "uat,sg");
+        assertThat(PropertySourcesTranslateUtil.map2YamlConverter(in)).isEqualTo("""
+                spring:
+                  profiles: uat
+                  profiles.active: uat,sg
+                """);
+    }
+
+    @Test
+    void emptyInputIsEmptyText() {
+        assertThat(PropertySourcesTranslateUtil.map2YamlConverter(Map.of())).isEmpty();
+    }
+
+    @Test
+    void segmentsKeepBracketsWhole() {
+        assertThat(PropertySourcesTranslateUtil.segments("a.b[0].[x.y]")).containsExactly("a", "b", "[0]", "[x.y]");
+        assertThat(PropertySourcesTranslateUtil.segments("a[x]")).containsExactly("a", "[x]");
+    }
+}
