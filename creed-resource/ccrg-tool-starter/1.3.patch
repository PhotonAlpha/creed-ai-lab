diff --git a/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/service/report/CrossoverConfluenceIndexRenderTest.java b/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/service/report/CrossoverConfluenceIndexRenderTest.java
