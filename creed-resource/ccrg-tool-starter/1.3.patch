+package com.creed.parent.service.report;
+
+import com.creed.parent.client.vo.confluence.attachment.SimpleAttachmentContentVO;
+import com.creed.parent.controller.prompt.vo.RouteInfoGroupingVO;
+import com.creed.parent.controller.vo.RouteFormVo;
+import com.creed.parent.controller.vo.RouteInfoVo;
+import com.creed.parent.service.ReportGenerationV2Service;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.thymeleaf.spring6.SpringTemplateEngine;
+import org.thymeleaf.templatemode.TemplateMode;
+import org.thymeleaf.templateresolver.ClassLoaderTemplateResolver;
+
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * The Confluence index page (`confluence-index.html`) for Crossover's combinations: two sources that differ above the
+ * instance (SG vs CN, another project) must be told apart on the page, and each side links its own project's release.
+ * The /ccrg/report shape (same country / app / environment on both sides) keeps its plain instance cells.
+ */
+class CrossoverConfluenceIndexRenderTest {
+
+    private static RouteInfoVo route(String project, String release, String country, String env, String instance) {
+        RouteInfoVo r = new RouteInfoVo();
+        r.setProjectName(project);
+        r.setReleaseName(release);
+        r.setCountryCode(country);
+        r.setApp("CCS");
+        r.setEnvironment(env);
+        r.setInstance(instance);
+        r.setZone("Z1");
+        return r;
+    }
+
+    private static RouteFormVo combination(String file, RouteInfoVo... routes) {
+        RouteFormVo form = new RouteFormVo();
+        form.setCompareAll(true);
+        form.setRoutes(List.of(routes));
+        SimpleAttachmentContentVO attachment = new SimpleAttachmentContentVO();
+        attachment.setTitle(file);
+        form.setSimpleAttachmentContent(attachment);
+        return form;
+    }
+
+    private static ReportGenerationV2Service service() {
+        ClassLoaderTemplateResolver resolver = new ClassLoaderTemplateResolver();
+        resolver.setPrefix("templates/");
+        resolver.setSuffix(".html");
+        resolver.setTemplateMode(TemplateMode.HTML);
+        resolver.setCharacterEncoding("UTF-8");
+        SpringTemplateEngine engine = new SpringTemplateEngine();
+        engine.setTemplateResolver(resolver);
+        ReportGenerationV2Service service = new ReportGenerationV2Service();
+        ReflectionTestUtils.setField(service, "springTemplateEngine", engine);
+        return service;
+    }
+
+    @Test
+    void sgAgainstCnNamesEachSideAndLinksEachProject() {
+        ReportGenerationV2Service service = service();
+        List<RouteInfoGroupingVO> grouping = service.groupingForTemplate(List.of(
+                combination("sg-vs-cn.html",
+                        route("idbproxy", "R18.1_12", "SG", "PROD", "PROD1"),
+                        route("idbgst", "R18.1_12", "CN", "UAT", "PROD1"))));
+
+        String html = service.renderHtmlTemplate(grouping);
+
+        assertThat(grouping.getFirst().getSourceArtifactoryUrl()).contains("/idbproxy/release/R18.1/12/");
+        assertThat(grouping.getFirst().getComparisonArtifactoryUrl()).contains("/idbgst/release/R18.1/12/");
+        assertThat(html)
+                .contains("<em>SG / CCS / PROD</em>", "<em>CN / CCS / UAT</em>")
+                .contains("ri:filename=\"sg-vs-cn.html\"");
+    }
+
+    @Test
+    void theReportPagesShapeStaysPlain() {
+        ReportGenerationV2Service service = service();
+        String html = service.renderHtmlTemplate(service.groupingForTemplate(List.of(
+                combination("r1-vs-r2.html",
+                        route("idbproxy", "R18.1_12", "SG", "PROD", "PROD1"),
+                        route("idbproxy", "R18.2_3", "SG", "PROD", "PROD2")))));
+
+        assertThat(html).contains("PROD1", "PROD2").doesNotContain("<em>");
+    }
+}
