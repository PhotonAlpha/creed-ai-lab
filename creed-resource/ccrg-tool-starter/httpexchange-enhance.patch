+                .httpRequestValuesProcessor((method, parameters, arguments, builder) -> builder
+                        .addHeader(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE)
+                        .addHeader(HttpHeaders.AUTHORIZATION, accessConfiguration.artifactoryBasicAuth()))
+                .build();
         return factory.createClient(ArtifactoryClient.class);
     }
 
+    /**
+     * Same pattern as {@link #artifactoryClient}; base URL and credentials from {@code access.confluence.*}. {@code X-Atlassian-Token: nocheck} only on the
+     * methods marked {@link AtlassianNoCheck}; and no JSON Content-Type on a method that declares its
+     * own (the multipart upload), or it would fight the multipart boundary.
+     */
     @Bean
-    public ConfluencePageClient confluencePageClient(RestTemplate restTemplate) {
+    public ConfluencePageClient confluencePageClient(RestTemplate restTemplate, ConfluenceAccessConfiguration confluenceAccess,
+                                                     Environment environment) {
         RestTemplateAdapter adapter = RestTemplateAdapter.create(restTemplate);
-        HttpServiceProxyFactory factory = HttpServiceProxyFactory.builderFor(adapter).build();
+        HttpServiceProxyFactory factory = HttpServiceProxyFactory.builderFor(adapter)
+                // the interface's "${access.confluence.base-url}"; required - a missing one fails startup
+                .embeddedValueResolver(environment::resolveRequiredPlaceholders)
+                .httpRequestValuesProcessor((method, parameters, arguments, builder) -> {
+                    builder.addHeader(HttpHeaders.AUTHORIZATION, confluenceAccess.authorization());
+                    if (builder.getContentType() == null) {
+                        builder.addHeader(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE);
+                    }
+                    if (method.isAnnotationPresent(AtlassianNoCheck.class)) {
+                        builder.addHeader(AtlassianNoCheck.HEADER, "nocheck");
+                    }
+                })
+                .build();
         return factory.createClient(ConfluencePageClient.class);
     }
 
