index 00000000..16f96ad8
--- /dev/null
+++ b/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/client/HttpExchangeHeaderTest.java
@@ -0,0 +1,136 @@
+package com.creed.parent.client;
+
+import com.creed.parent.config.RestConfiguration;
+import com.creed.parent.repo.AccessConfiguration;
+import com.creed.parent.repo.ConfluenceAccessConfiguration;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.core.io.ByteArrayResource;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.MediaType;
+import org.springframework.mock.env.MockEnvironment;
+import org.springframework.test.web.client.MockRestServiceServer;
+import org.springframework.web.client.RestTemplate;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+import java.util.Map;
+
+import static org.springframework.test.web.client.match.MockRestRequestMatchers.content;
+import static org.springframework.test.web.client.match.MockRestRequestMatchers.header;
+import static org.springframework.test.web.client.match.MockRestRequestMatchers.headerDoesNotExist;
+import static org.springframework.test.web.client.match.MockRestRequestMatchers.method;
+import static org.springframework.test.web.client.match.MockRestRequestMatchers.requestTo;
+import static org.springframework.test.web.client.response.MockRestResponseCreators.withSuccess;
+
+/**
+ * The clients are built through the real {@link RestConfiguration} bean methods: auth is added by
+ * their request-values processors, not passed per call. (Background: Spring Framework 7's HttpHeaders
+ * is no longer a MultiValueMap, so the old {@code @RequestHeader HttpHeaders} parameter silently
+ * became one header named after the parameter and every call went out without Authorization.)
+ */
+class HttpExchangeHeaderTest {
+
+    private static final String CONFLUENCE_BASE = "https://acme.atlassian.net/wiki";
+    private static final String CONFLUENCE = CONFLUENCE_BASE + "/rest/api";
+
+    private final RestConfiguration config = new RestConfiguration();
+    private final AccessConfiguration access = new AccessConfiguration();
+    private final ConfluenceAccessConfiguration confluenceAccess = new ConfluenceAccessConfiguration();
+    private final MockEnvironment environment = new MockEnvironment().withProperty("access.confluence.base-url", CONFLUENCE_BASE);
+    private RestTemplate restTemplate;
+    private MockRestServiceServer server;
+
+    @BeforeEach
+    void setUp() {
+        access.setTokenKey("user");
+        access.setTokenValue("secret");
+        confluenceAccess.setBaseUrl(CONFLUENCE_BASE);
+        confluenceAccess.setToken("t0ken");   // no user = Data Center PAT
+        restTemplate = new RestTemplate();
+        server = MockRestServiceServer.bindTo(restTemplate).build();
+    }
+
+    private ConfluencePageClient confluencePageClient() {
+        return config.confluencePageClient(restTemplate, confluenceAccess, environment);
+    }
+
+    private static String basic(String key, String value) {
+        return "Basic " + Base64.getEncoder().encodeToString((key + ":" + value).getBytes(StandardCharsets.UTF_8));
+    }
+
+    @Test
+    void artifactoryClientAddsBasicAuthReadPerCall() {
+        server.expect(requestTo("https://artifactory.example.com/artifactory/api/storage/P/R/master"))
+                .andExpect(method(HttpMethod.GET))
+                .andExpect(header(HttpHeaders.AUTHORIZATION, basic("user", "secret")))
+                .andRespond(withSuccess("{}", MediaType.APPLICATION_JSON));
+        // token rotated after the bean was created → the next call must use the new one
+        server.expect(requestTo("https://artifactory.example.com/artifactory/api/storage/P/R/release"))
+                .andExpect(header(HttpHeaders.AUTHORIZATION, basic("user", "rotated")))
+                .andRespond(withSuccess("{}", MediaType.APPLICATION_JSON));
+
+        ArtifactoryClient client = config.artifactoryClient(restTemplate, access);
+        client.getMasterList("P", "R");
+        access.setTokenValue("rotated");
+        client.getReleaseList("P", "R");
+        server.verify();
+    }
+
+    @Test
+    void confluenceClientAddsBearerWithoutXsrfOnOrdinaryCalls() {
+        server.expect(requestTo(CONFLUENCE + "/content/123?expand=body"))
+                .andExpect(method(HttpMethod.GET))
+                .andExpect(header(HttpHeaders.AUTHORIZATION, "Bearer t0ken"))
+                .andExpect(headerDoesNotExist(AtlassianNoCheck.HEADER))
+                .andRespond(withSuccess("{}", MediaType.APPLICATION_JSON));
+
+        confluencePageClient().getContentById("123", Map.of("expand", "body"));
+        server.verify();
+    }
+
+    /** Cloud API tokens only work as Basic email:token, and the REST API lives under /wiki. */
+    @Test
+    void confluenceCloudUsesBasicEmailTokenUnderWiki() {
+        confluenceAccess.setUser("me@acme.com");
+        server.expect(requestTo("https://acme.atlassian.net/wiki/rest/api/content/123?expand=body"))
+                .andExpect(header(HttpHeaders.AUTHORIZATION, basic("me@acme.com", "t0ken")))
+                .andRespond(withSuccess("{}", MediaType.APPLICATION_JSON));
+
+        confluencePageClient().getContentById("123", Map.of("expand", "body"));
+        server.verify();
+    }
+
+    @Test
+    void confluenceMoveCarriesXsrfNoCheck() {
+        server.expect(requestTo(CONFLUENCE + "/content/1/child/attachment/2/move?newContentId=3"))
+                .andExpect(method(HttpMethod.POST))
+                .andExpect(header(HttpHeaders.AUTHORIZATION, "Bearer t0ken"))
+                .andExpect(header(AtlassianNoCheck.HEADER, "nocheck"))
+                .andRespond(withSuccess());
+
+        confluencePageClient().moveAttachment("1", "2", Map.of("newContentId", "3"));
+        server.verify();
+    }
+
+    @Test
+    void confluenceUploadIsMultipartWithXsrfNoCheck() {
+        server.expect(requestTo(CONFLUENCE + "/content/1/child/attachment"))
+                .andExpect(method(HttpMethod.POST))
+                .andExpect(header(HttpHeaders.AUTHORIZATION, "Bearer t0ken"))
+                .andExpect(header(AtlassianNoCheck.HEADER, "nocheck"))
+                // the processor must not force application/json over the declared multipart type
+                .andExpect(content().contentTypeCompatibleWith(MediaType.MULTIPART_FORM_DATA))
+                .andRespond(withSuccess("{}", MediaType.APPLICATION_JSON));
+
+        ByteArrayResource file = new ByteArrayResource("x".getBytes(StandardCharsets.UTF_8)) {
+            @Override
+            public String getFilename() {
+                return "a.txt";
+            }
+        };
+        confluencePageClient().uploadAttachment("1", file, "c");
+        server.verify();
+    }
+}
