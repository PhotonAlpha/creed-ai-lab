@@ -0,0 +1,39 @@
+package com.creed.parent.repo;
+
+import lombok.Data;
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.boot.context.properties.ConfigurationProperties;
+import org.springframework.context.annotation.Configuration;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+
+/**
+ * {@code access.confluence.*}. Bound on its own: the old {@code AccessConfiguration#bearerToken} sat under
+ * {@code access.arti.*}, where nothing set it, so every Confluence call went out as {@code Bearer null}.
+ */
+@ConfigurationProperties(prefix = "access.confluence")
+@Configuration
+@Data
+public class ConfluenceAccessConfiguration {
+
+    /**
+     * Everything before {@code /rest/api}: {@code https://<site>.atlassian.net/wiki} on Cloud (the {@code /wiki}
+     * is part of it), the context root on Data Center. Also resolves the {@code ConfluencePageClient} URLs.
+     */
+    private String baseUrl;
+
+    /** Cloud: the Atlassian account e-mail. Blank = Data Center personal access token. */
+    private String user;
+
+    private String token;
+
+    /**
+     * Cloud API tokens ({@code ATATT…}) only work as {@code Basic base64(email:token)} - sent as Bearer they are a
+     * 401. A Data Center PAT is a Bearer token. Built per call so a changed token is picked up.
+     */
+    public String authorization() {
+        return StringUtils.isBlank(user) ? "Bearer " + token
+                : "Basic " + Base64.getEncoder().encodeToString((user + ":" + token).getBytes(StandardCharsets.UTF_8));
+    }
+}
