diff --git a/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/client/HttpExchangeHeaderTest.java b/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/client/HttpExchangeHeaderTest.java
