+package com.creed.parent.client;
+
+import java.lang.annotation.Documented;
+import java.lang.annotation.ElementType;
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+import java.lang.annotation.Target;
+
+/**
+ * Marks a {@link ConfluencePageClient} method whose request must carry
+ * {@code X-Atlassian-Token: nocheck} — Confluence's XSRF check rejects attachment
+ * upload/move without it. Read by the request-values processor in
+ * {@code RestConfiguration#confluencePageClient}.
+ */
+@Documented
+@Target(ElementType.METHOD)
+@Retention(RetentionPolicy.RUNTIME)
+public @interface AtlassianNoCheck {
+
+    String HEADER = "X-Atlassian-Token";
+}
