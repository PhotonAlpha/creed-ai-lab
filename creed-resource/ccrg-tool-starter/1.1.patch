diff --git a/creed-resource/ccrg-tool-starter/src/main/java/com/creed/parent/service/report/alert/AesConfigCipher.java b/creed-resource/ccrg-tool-starter/src/main/java/com/creed/parent/service/report/alert/AesConfigCipher.java
new file mode 100644
index 00000000..516b39d7
--- /dev/null
+++ b/creed-resource/ccrg-tool-starter/src/main/java/com/creed/parent/service/report/alert/AesConfigCipher.java
@@ -0,0 +1,123 @@
+package com.creed.parent.service.report.alert;
+
+import org.springframework.stereotype.Component;
+
+import javax.crypto.BadPaddingException;
+import javax.crypto.Cipher;
+import javax.crypto.SecretKeyFactory;
+import javax.crypto.spec.IvParameterSpec;
+import javax.crypto.spec.PBEKeySpec;
+import javax.crypto.spec.SecretKeySpec;
+import java.nio.ByteBuffer;
+import java.nio.charset.CharacterCodingException;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.util.Base64;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * {@link ConfigCipher} for the configuration files' secrets - the same scheme as env-matrix's AES records:
+ * <pre>
+ *   key        = PBKDF2WithHmacSHA256(UTF-8(host + ip + randomKey), UTF-8(salt), 65 536 iterations, 256 bit)
+ *   ciphertext = Base64(AES/CBC/PKCS5Padding(UTF-8(plain), key, IV = the 16 UTF-8 bytes of common.iv))
+ * </pre>
+ * Decryption is strict: a wrong key usually fails the padding check, and the rare wrong key that pads correctly
+ * fails the UTF-8 decode - never a silent "decrypted" to garbage.
+ *
+ * <p>65 536 PBKDF2 iterations cost tens of milliseconds, and one report decrypts every password of both sides with a
+ * handful of (key, salt) pairs: derived keys are kept in a small LRU, by the two inputs (a record - a joined string
+ * could make two different pairs collide).
+ */
+@Component
+public class AesConfigCipher implements ConfigCipher {
+
+    static final int ITERATIONS = 65_536;
+    static final int KEY_BITS = 256;
+    static final int IV_BYTES = 16;
+    private static final String TRANSFORMATION = "AES/CBC/PKCS5Padding";
+    private static final int CACHED_KEYS = 64;
+
+    private record KeyInput(String secretKey, String salt) {
+        @Override
+        public String toString() {
+            return "KeyInput[…]";
+        }
+    }
+
+    private final Map<KeyInput, SecretKeySpec> keys = Collections.synchronizedMap(new LinkedHashMap<>(16, 0.75f, true) {
+        @Override
+        protected boolean removeEldestEntry(Map.Entry<KeyInput, SecretKeySpec> eldest) {
+            return size() > CACHED_KEYS;
+        }
+    });
+
+    @Override
+    public String encrypt(String plainText, CipherMaterial material) {
+        Objects.requireNonNull(plainText, "plainText");
+        try {
+            Cipher cipher = cipher(Cipher.ENCRYPT_MODE, material);
+            return Base64.getEncoder().encodeToString(cipher.doFinal(plainText.getBytes(StandardCharsets.UTF_8)));
+        } catch (GeneralSecurityException e) {
+            throw new IllegalStateException("cannot encrypt with " + material + ": " + e.getClass().getSimpleName(), e);
+        }
+    }
+
+    @Override
+    public String decrypt(String cipherText, CipherMaterial material) {
+        byte[] bytes;
+        try {
+            bytes = Base64.getDecoder().decode(cipherText.trim());
+        } catch (IllegalArgumentException e) {
+            throw new IllegalArgumentException("not Base64");
+        }
+        try {
+            byte[] plain = cipher(Cipher.DECRYPT_MODE, material).doFinal(bytes);
+            return StandardCharsets.UTF_8.newDecoder()
+                    .onMalformedInput(CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(CodingErrorAction.REPORT)
+                    .decode(ByteBuffer.wrap(plain)).toString();
+        } catch (BadPaddingException e) {
+            throw new IllegalStateException("wrong key, salt or IV (bad padding)");
+        } catch (CharacterCodingException e) {
+            throw new IllegalStateException("wrong key, salt or IV (not UTF-8)");
+        } catch (GeneralSecurityException e) {
+            throw new IllegalStateException("cannot decrypt: " + e.getClass().getSimpleName());
+        }
+    }
+
+    private Cipher cipher(int mode, CipherMaterial material) throws GeneralSecurityException {
+        byte[] iv = material.iv() == null ? new byte[0] : material.iv().getBytes(StandardCharsets.UTF_8);
+        if (iv.length != IV_BYTES) {
+            // checked before the salt: two bad fields always name the same one
+            throw new IllegalArgumentException("IV must be " + IV_BYTES + " UTF-8 bytes, is " + iv.length);
+        }
+        if (material.salt() == null || material.salt().isEmpty()) {
+            throw new IllegalArgumentException("salt is required");
+        }
+        Cipher cipher = Cipher.getInstance(TRANSFORMATION);
+        cipher.init(mode, key(material), new IvParameterSpec(iv));
+        return cipher;
+    }
+
+    private SecretKeySpec key(CipherMaterial material) throws GeneralSecurityException {
+        KeyInput input = new KeyInput(material.secretKey(), material.salt());
+        SecretKeySpec cached = keys.get(input);
+        if (cached != null) {
+            return cached;
+        }
+        PBEKeySpec spec = new PBEKeySpec(input.secretKey().toCharArray(), input.salt().getBytes(StandardCharsets.UTF_8),
+                ITERATIONS, KEY_BITS);
+        try {
