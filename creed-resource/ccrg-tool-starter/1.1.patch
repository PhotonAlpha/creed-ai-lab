@@ -0,0 +1,55 @@
+package com.creed.parent.service.report;
+
+import com.creed.parent.service.report.alert.AesConfigCipher;
+import com.creed.parent.service.report.alert.ConfigCipher.CipherMaterial;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class AesConfigCipherTest {
+
+    private final AesConfigCipher cipher = new AesConfigCipher();
+    private final CipherMaterial pdn0771 = new CipherMaterial("lxcreed077", "192.168.5.11", "srvR4nd0m", "idb-s4lt", "IDBccsGw2026IV16");
+
+    /**
+     * env-matrix's AES record vector (AesCryptoService / server/aes.js, matched by openssl): the same PBKDF2 + AES-CBC
+     * scheme. Its secret key is randomKey + host + ip, so the parts are passed in the order that concatenates to it.
+     */
+    @Test
+    void decryptsEnvMatrixsPinnedVector() {
+        CipherMaterial m = new CipherMaterial("r4nd0m", "ms1.cn.uat1", "10.1.1.11", "s4lt 盐", "0123456789abcdef");
+        assertThat(m.secretKey()).isEqualTo("r4nd0mms1.cn.uat110.1.1.11");
+        assertThat(cipher.decrypt("H24JNkxfMPSBHI3vtO41cQ==", m)).isEqualTo("db-p@ss 密码");
+        assertThat(cipher.encrypt("db-p@ss 密码", m)).isEqualTo("H24JNkxfMPSBHI3vtO41cQ==");
+    }
+
+    @Test
+    void roundTripsAndAnyWrongPartFails() {
+        String ct = cipher.encrypt("KeyStore#0771", pdn0771);
+        assertThat(cipher.decrypt(ct, pdn0771)).isEqualTo("KeyStore#0771");
+
+        for (CipherMaterial wrong : new CipherMaterial[]{
+                new CipherMaterial("lxcreed001", "192.168.5.11", "srvR4nd0m", "idb-s4lt", "IDBccsGw2026IV16"),
+                new CipherMaterial("lxcreed077", "192.168.5.12", "srvR4nd0m", "idb-s4lt", "IDBccsGw2026IV16"),
+                new CipherMaterial("lxcreed077", "192.168.5.11", "msR4nd0m", "idb-s4lt", "IDBccsGw2026IV16"),
+                new CipherMaterial("lxcreed077", "192.168.5.11", "srvR4nd0m", "other-salt", "IDBccsGw2026IV16")}) {
+            assertThatThrownBy(() -> cipher.decrypt(ct, wrong)).isInstanceOf(IllegalStateException.class)
+                    .hasMessageStartingWith("wrong key, salt or IV");
+        }
+    }
+
+    @Test
+    void badInputIsRejectedNotDecryptedToGarbage() {
+        assertThatThrownBy(() -> cipher.decrypt("not base64 !!", pdn0771)).hasMessage("not Base64");
+        CipherMaterial shortIv = new CipherMaterial("h", "i", "r", "s", "short");
+        assertThatThrownBy(() -> cipher.decrypt("AAAA", shortIv)).hasMessageContaining("IV must be 16 UTF-8 bytes");
+        CipherMaterial noSalt = new CipherMaterial("h", "i", "r", "", "IDBccsGw2026IV16");
+        assertThatThrownBy(() -> cipher.encrypt("x", noSalt)).hasMessage("salt is required");
+    }
+
+    @Test
+    void materialNeverPrintsTheKeyParts() {
+        assertThat(pdn0771.toString()).contains("lxcreed077").doesNotContain("srvR4nd0m", "idb-s4lt", "IDBccsGw2026IV16");
+    }
+}
diff --git a/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/service/report/EncryptedSecretAlertTest.java b/creed-resource/ccrg-tool-starter/src/test/java/com/creed/parent/service/report/EncryptedSecretAlertTest.java
