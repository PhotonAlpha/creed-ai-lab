+package com.creed.parent.service.report.alert;
+
+/**
+ * An encrypted secret that decrypted: the Overall Comparison marks its line "decrypts" and reveals {@code plainText}
+ * on click. The plain text is embedded in the report HTML (chosen 2026-11-20, so the Confluence page and the
+ * downloaded file can reveal it too) - whoever can open the report can read it from the page source.
+ *
+ * @param side "baseline" or "comparison"
+ */
+public record DecryptedSecret(String key, String side, String plainText) {
+
+    /** Never the plain text in a log line. */
+    @Override
+    public String toString() {
+        return "DecryptedSecret[key=" + key + ", side=" + side + "]";
+    }
+}
