@@ -0,0 +1,172 @@
+package com.creed.parent.service.report;
+
+import com.creed.parent.model.ReportDetails;
+import com.creed.parent.service.report.alert.ConfigAlert;
+import com.creed.parent.service.report.alert.ConfigAlertProperties;
+import com.creed.parent.service.report.alert.ConfigAlertRule;
+import com.creed.parent.service.report.alert.ConfigAlertService;
+import com.creed.parent.service.report.alert.ConfigAlertSeverity;
+import com.creed.parent.service.report.alert.ConfigCipher;
+import com.creed.parent.service.report.alert.DecryptedSecret;
+import com.creed.parent.service.report.alert.InstanceAddressLookup;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * The SECRET rule for secrets encrypted with host + IP + randomKey, salt and IV ({@code server.access.*} /
+ * {@code ms.access.*} beside {@code common.iv} / {@code common.salt}): decrypts -> no alert, a {@link DecryptedSecret};
+ * does not, or cannot be tried -> CRITICAL.
+ */
+class EncryptedSecretAlertTest {
+
+    /** Stands in for the team's AES: "enc:" + secretKey + "|" + salt + "|" + iv + ":" + plain. */
+    static final class FakeCipher implements ConfigCipher {
+        final List<CipherMaterial> seen = new ArrayList<>();
+
+        @Override
+        public String encrypt(String plainText, CipherMaterial m) {
+            return "enc:" + m.secretKey() + "|" + m.salt() + "|" + m.iv() + ":" + plainText;
+        }
+
+        @Override
+        public String decrypt(String cipherText, CipherMaterial m) {
+            seen.add(m);
+            String prefix = "enc:" + m.secretKey() + "|" + m.salt() + "|" + m.iv() + ":";
+            if (!cipherText.startsWith(prefix)) {
+                throw new IllegalStateException("Given final block not properly padded");
+            }
+            return cipherText.substring(prefix.length());
+        }
+    }
+
+    private static final InstanceAddressLookup ADDRESSES = instance -> "PDN0771".equalsIgnoreCase(instance)
+            ? Optional.of(new InstanceAddressLookup.InstanceAddress("lxcreed077", "192.168.5.11"))
+            : Optional.empty();
+
+    private final ConfigAlertProperties props = new ConfigAlertProperties();
+    private final FakeCipher cipher = new FakeCipher();
+    private final ConfigAlertService service = new ConfigAlertService(props, ADDRESSES, cipher);
+
+    private static ReportDetails instance(String instance) {
+        ReportDetails d = new ReportDetails();
+        d.setEnvironment("PDN");
+        d.setInstance(instance);
+        return d;
+    }
+
+    /** One side as the files hold it, every password encrypted for PDN0771. */
+    private Map<String, String> pdn0771(String keyStorePassword) {
+        ConfigCipher.CipherMaterial server = new ConfigCipher.CipherMaterial("lxcreed077", "192.168.5.11", "srvRnd", "s4lt", "iv16bytes-------");
+        ConfigCipher.CipherMaterial ms = new ConfigCipher.CipherMaterial("lxcreed077", "192.168.5.11", "msRnd", "s4lt", "iv16bytes-------");
+        Map<String, String> m = new HashMap<>();
+        m.put("common.iv", "iv16bytes-------");
+        m.put("common.salt", "s4lt");
+        m.put("server.access.randomKey", "srvRnd");
+        m.put("server.access.key-store-password", cipher.encrypt(keyStorePassword, server));
+        m.put("server.access.trust-store-password", cipher.encrypt("trust#1", server));
+        m.put("ms.access.randomKey", "msRnd");
+        m.put("ms.access.key-store-password", cipher.encrypt("ms-ks#1", ms));
+        m.put("ms.access.trust-store-password", cipher.encrypt("ms-ts#1", ms));
+        return m;
+    }
+
+    private static List<ConfigAlert> rule(List<ConfigAlert> alerts, ConfigAlertRule rule) {
+        return alerts.stream().filter(a -> a.getRule() == rule).toList();
+    }
+
+    @Test
+    void secretsThatDecryptAreNoAlertButComeBackDecrypted() {
+        ConfigAlertService.Evaluation result = service.evaluateAll(pdn0771("ks#1"), pdn0771("ks#2"),
+                instance("PDN0771"), instance("pdn0771"));
+
+        // asked for: no "Unencrypted secret" (nor any other secret alert) for what decrypts
+        assertThat(rule(result.alerts(), ConfigAlertRule.PLAIN_SECRET)).isEmpty();
+        assertThat(rule(result.alerts(), ConfigAlertRule.ENCRYPTED_SECRET_UNREADABLE)).isEmpty();
+        assertThat(result.decrypted()).hasSize(8).contains(
+                new DecryptedSecret("server.access.key-store-password", "baseline", "ks#1"),
+                new DecryptedSecret("server.access.key-store-password", "comparison", "ks#2"),
+                new DecryptedSecret("ms.access.trust-store-password", "comparison", "ms-ts#1"));
+        // the key is host + ip + the group's own randomKey
+        assertThat(cipher.seen).extracting(ConfigCipher.CipherMaterial::secretKey)
+                .contains("lxcreed077192.168.5.11srvRnd", "lxcreed077192.168.5.11msRnd");
+        // the random key is not itself a secret, and the material never prints its key
+        assertThat(result.alerts()).extracting(ConfigAlert::getKey).doesNotContain("server.access.randomKey");
+        assertThat(cipher.seen.getFirst().toString()).doesNotContain("srvRnd", "s4lt");
+    }
+
+    @Test
+    void aValueThatDoesNotDecryptIsCriticalAndMaskedAsEncrypted() {
+        Map<String, String> right = pdn0771("ks#1");
+        right.put("server.access.key-store-password", "QmFzZTY0Z2FyYmFnZQ==");
+
+        List<ConfigAlert> alerts = service.evaluate(pdn0771("ks#1"), right, instance("PDN0771"), instance("PDN0771"));
+
+        assertThat(rule(alerts, ConfigAlertRule.ENCRYPTED_SECRET_UNREADABLE)).singleElement().satisfies(a -> {
+            assertThat(a.getSeverity()).isEqualTo(ConfigAlertSeverity.CRITICAL);
+            assertThat(a.getKey()).isEqualTo("server.access.key-store-password");
+            assertThat(a.getSide()).isEqualTo("comparison");
+            assertThat(a.getReason()).contains("Comparison: does not decrypt", "lxcreed077", "server.access.randomKey",
+                    "IllegalStateException");
+            assertThat(a.getRightValue()).isEqualTo("•••••••• (20 chars, encrypted)").doesNotContain("QmFz");
+            assertThat(a.getLeftValue()).contains("encrypted");
+        });
+        assertThat(rule(alerts, ConfigAlertRule.PLAIN_SECRET)).isEmpty();
+        assertThat(alerts.getFirst().getSeverity()).isEqualTo(ConfigAlertSeverity.CRITICAL);
+    }
+
+    @Test
+    void anInstanceWithoutHostAndIpCannotDecrypt() {
+        List<ConfigAlert> alerts = service.evaluate(pdn0771("ks#1"), pdn0771("ks#1"), instance("PDN0771"), instance("QUA177"));
+
+        assertThat(rule(alerts, ConfigAlertRule.ENCRYPTED_SECRET_UNREADABLE))
+                .hasSize(4)
+                .allSatisfy(a -> {
+                    assertThat(a.getSide()).isEqualTo("comparison");
+                    assertThat(a.getReason()).contains("instance 'QUA177' has no host / IP in instance_host");
+                });
+    }
+
+    @Test
+    void missingIvSaltOrNoCipherIsCriticalNotSilentlyFine() {
+        Map<String, String> noIv = pdn0771("ks#1");
+        noIv.remove("common.iv");
+        assertThat(rule(service.evaluate(noIv, Map.of(), instance("PDN0771"), instance("PDN0771")),
+                ConfigAlertRule.ENCRYPTED_SECRET_UNREADABLE))
+                .isNotEmpty().allSatisfy(a -> assertThat(a.getReason()).contains("not set: common.iv"));
+
+        ConfigAlertService noCipher = new ConfigAlertService(props, ADDRESSES, (ConfigCipher) null);
+        assertThat(rule(noCipher.evaluate(pdn0771("ks#1"), Map.of(), instance("PDN0771"), instance("PDN0771")),
+                ConfigAlertRule.ENCRYPTED_SECRET_UNREADABLE))
+                .hasSize(4).allSatisfy(a -> assertThat(a.getReason()).contains("no ConfigCipher implementation"));
+    }
+
+    @Test
+    void aSecretWithoutRandomKeyIsStillPlainTextAndPlaceholdersAreFine() {
+        Map<String, String> left = new HashMap<>(Map.of(
+                "spring.datasource.password", "Prod#2026!",
+                "server.access.randomKey", "srvRnd",
+                "server.access.key-store-password", "${KEY_STORE_PASSWORD}"));
+
+        List<ConfigAlert> alerts = service.evaluate(left, left, instance("PDN0771"), instance("PDN0771"));
+
+        assertThat(alerts).extracting(ConfigAlert::getRule, ConfigAlert::getKey)
+                .containsExactly(org.assertj.core.groups.Tuple.tuple(ConfigAlertRule.PLAIN_SECRET, "spring.datasource.password"));
+        assertThat(cipher.seen).isEmpty();
+    }
+
+    @Test
+    void encryptionCheckCanBeSwitchedOff() {
+        props.getEncryption().setEnabled(false);
+        List<ConfigAlert> alerts = service.evaluate(pdn0771("ks#1"), Map.of(), instance("PDN0771"), instance("PDN0771"));
+        // without the check the ciphertexts are just plain values again
+        assertThat(rule(alerts, ConfigAlertRule.PLAIN_SECRET)).hasSize(4);
+        assertThat(rule(alerts, ConfigAlertRule.ENCRYPTED_SECRET_UNREADABLE)).isEmpty();
+    }
+}
