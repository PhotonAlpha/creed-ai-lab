@@ -0,0 +1,51 @@
+package com.creed.parent.service.report.alert;
+
+/**
+ * Encrypts / decrypts a secret of the compared configuration files (asked for, 2026-11-20 - to be implemented by the
+ * team: AES with a key derived from {@link CipherMaterial#secretKey()}, the salt and the IV). Declare the
+ * implementation as a Spring bean; {@link ConfigAlertService} picks it up. Without one, every encrypted secret is
+ * reported as not decryptable (CRITICAL), since nothing can prove it is.
+ *
+ * <p>A secret is encrypted when its group carries a random key: {@code server.access.key-store-password} with
+ * {@code server.access.randomKey} beside it; IV and salt are shared by the file ({@code common.iv},
+ * {@code common.salt}; keys configurable under {@code ccrg.alerts.encryption}).
+ *
+ * @author EthanCao
+ * @description ccrg-tool
+ * @date 2026-11-20
+ */
+public interface ConfigCipher {
+
+    /**
+     * @return Base64 ciphertext as the configuration file holds it
+     */
+    String encrypt(String plainText, CipherMaterial material);
+
+    /**
+     * @return the plain text; throwing, or returning {@code null}, means the value does not decrypt (CRITICAL)
+     */
+    String decrypt(String cipherText, CipherMaterial material);
+
+    /**
+     * What a value of one side was encrypted with.
+     *
+     * @param host      the side's instance's host ({@code instance_host}, by {@code routes -> instance})
+     * @param ip        the side's instance's IP
+     * @param randomKey the group's {@code randomKey} (e.g. {@code server.access.randomKey})
+     * @param salt      {@code common.salt}
+     * @param iv        {@code common.iv}
+     */
+    record CipherMaterial(String host, String ip, String randomKey, String salt, String iv) {
+
+        /** {@code host + ip + randomKey}, concatenated as is. */
+        public String secretKey() {
+            return host + ip + randomKey;
+        }
+
+        /** Never the key material: what a log line or an alert may say about it. */
+        @Override
+        public String toString() {
+            return "CipherMaterial[host=" + host + ", ip=" + ip + "]";
+        }
+    }
+}
