--- a/creed-resource/ccrg-tool-starter/src/main/java/com/creed/parent/config/RestConfiguration.java
+++ b/creed-resource/ccrg-tool-starter/src/main/java/com/creed/parent/config/RestConfiguration.java
@@ -197,12 +197,12 @@ public class RestConfiguration {
      * {@code restTemplate} because Confluence's download goes through that same template.
      */
     @Bean
-    public ArtifactoryClient artifactoryClient(RestTemplate restTemplate, AccessConfiguration accessConfiguration) {
+    public ArtifactoryClient artifactoryClient(RestTemplate restTemplate, ConfluenceAccessConfiguration accessConfiguration) {
         RestTemplateAdapter adapter = RestTemplateAdapter.create(restTemplate);
         HttpServiceProxyFactory factory = HttpServiceProxyFactory.builderFor(adapter)
                 .httpRequestValuesProcessor((method, parameters, arguments, builder) -> builder
                         .addHeader(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE)
-                        .addHeader(HttpHeaders.AUTHORIZATION, accessConfiguration.artifactoryBasicAuth()))
+                        .addHeader(HttpHeaders.AUTHORIZATION, accessConfiguration.authorization()))
                 .build();
         return factory.createClient(ArtifactoryClient.class);
     }
