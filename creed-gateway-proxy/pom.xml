<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.creed</groupId>
        <artifactId>spring-creed-auth-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>creed-gateway-proxy</artifactId>
    <name>creed-gateway-proxy</name>
    <description>Env Matrix front door: serves the built frontend, owns the Splunk session broker, proxies the rest of /api (and ssh -R tunnels)</description>
    <dependencies>
        <!-- Standalone on purpose: no config client, no load balancer, no OAuth2. A route's target is
             a loopback port an ssh -R tunnel opened, not a service instance. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <!-- Splunk session broker audit (creed.splunk.audit.store=pg|mysql). Plain JDBC over a pool the
             store builds itself — deliberately no spring-jdbc, so no DataSource is auto-configured
             (and demanded) when the store is the default in-memory one. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
