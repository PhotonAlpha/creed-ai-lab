<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.creed</groupId>
        <artifactId>spring-creed-auth-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>creed-gateway-proxy</artifactId>
    <name>creed-gateway-proxy</name>
    <description>Server-side reverse proxy (nginx proxy_pass) onto ssh -R tunnels, e.g. a laptop's Vite dev server</description>
    <dependencies>
        <!-- Standalone on purpose: no config client, no load balancer, no OAuth2. A route's target is
             a loopback port an ssh -R tunnel opened, not a service instance. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
