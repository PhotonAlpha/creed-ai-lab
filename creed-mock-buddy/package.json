{
  "name": "creed-mock-buddy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Config-driven mock API platform — Fastify 5 + TypeScript, YAML-defined routes with scenarios, latency and fault injection",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/under-pressure": "9.1.0",
    "fastify": "5.12.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "autocannon": "8.0.0",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
